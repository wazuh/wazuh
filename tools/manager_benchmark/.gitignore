# Per-run artifacts written by run_benchmark.sh
results_*/

# The load report and its evidence are GENERATED, not source: the numbers belong to
# whatever machine produced them, so they are kept local and regenerated per
# environment (see "Regenerating the load report" in README.md).
LOAD_REPORT.md
load_report_data/
bench_env.txt

# The fleet's enrollment token, minted on the manager under test by
# prepare_manager.sh and read by run_benchmark.sh. A credential of ONE machine,
# and short-lived: never committed.
.enrollment_token

# Python bytecode
__pycache__/
*.pyc

# Generated by make_report_tables.py
tables.md
