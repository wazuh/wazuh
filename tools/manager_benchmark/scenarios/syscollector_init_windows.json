{
  "name": "syscollector_init_windows",
  "description": "Windows fleet running a syscollector full_resync (initial inventory scan) followed by a checksum reconcile step. Windows twin of syscollector_init_debian.",
  "mode": "uds",
  "defaults": {
    "module": "syscollector",
    "option": "Sync",
    "cluster_name": "cluster01"
  },
  "lanes": {
    "syscollector": [
      { "kind": "full_resync", "module": "syscollector", "indices": ["wazuh-states-inventory-packages"],
        "documents": { "count": 600, "size_bytes": 256 } },
      { "kind": "checksum", "module": "syscollector", "indices": ["wazuh-states-inventory-packages"], "checksum": "correct" }
    ]
  },
  "fleets": [
    { "name": "windows", "agents": 8, "first_id": 17000, "lanes": ["syscollector"],
      "start": { "osname": "Windows 11", "osplatform": "windows", "ostype": "windows", "osversion": "10.0.22631", "architecture": "x86_64", "agentversion": "5.0.0" } }
  ],
  "pacing": { "concurrent_agents": 0, "requests_per_second": 0, "repeat_until": "0", "drain_timeout": "60s" }
}
