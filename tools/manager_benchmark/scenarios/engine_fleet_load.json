{
  "name": "engine_fleet_load",
  "description": "Agent-mode load test: a 25-agent Linux fleet running a single looping syslog engine lane at sustained high throughput, alongside any sibling lanes should they be added later.",
  "mode": "agent",
  "defaults": {
    "cluster_name": "cluster01",
    "control": { "enabled": true, "keepalive_interval": "10s", "send_host_info": true, "startup_version": "5.0.0" }
  },
  "lanes": {
    "engine": [
      { "kind": "engine", "engine": "../sample_payloads/engine/syslog.log", "location": "syslog",
        "events_per_second": 400, "events_per_batch": 100 }
    ]
  },
  "fleets": [
    { "name": "linux", "agents": 25, "first_id": 24000, "lanes": ["engine"],
      "start": { "osname": "Ubuntu", "osplatform": "ubuntu", "ostype": "linux", "osversion": "22.04", "architecture": "x86_64", "agentversion": "5.0.0" } }
  ],
  "pacing": { "concurrent_agents": 0, "requests_per_second": 0, "repeat_until": "0", "drain_timeout": "60s" }
}
