{
  "name": "mixed_fleet_windows_linux_only_stateless",
  "description": "The stateless-only twin of mixed_fleet_windows_linux: agent mode with /control keepalives, each agent shipping only a mixed-content engine (log-event) lane, no FIM/SCA/syscollector/VD inventory lanes.",
  "mode": "agent",
  "defaults": {
    "module": "syscollector",
    "option": "Sync",
    "cluster_name": "cluster01",
    "control": { "enabled": true, "keepalive_interval": "10s", "send_host_info": true, "startup_version": "5.0.0" }
  },
  "lanes": {
    "engine": [
      { "kind": "engine", "engine": "../sample_payloads/engine/test_logs_merged.txt", "location": "mixed",
        "events_per_second": 250, "events_per_batch": 100 }
    ]
  },
  "fleets": [
    { "name": "windows", "agents": 50, "first_id": 1000, "lanes": ["engine"],
      "start": { "osname": "Windows 11", "osplatform": "windows", "ostype": "windows", "osversion": "10.0.22631", "architecture": "x86_64", "agentversion": "5.0.0" } },
    { "name": "linux", "agents": 50, "first_id": 2000, "lanes": ["engine"],
      "start": { "osname": "Ubuntu", "osplatform": "ubuntu", "ostype": "linux", "osversion": "22.04", "architecture": "x86_64", "agentversion": "5.0.0" } }
  ],
  "pacing": { "concurrent_agents": 0, "requests_per_second": 0, "repeat_until": "20m", "drain_timeout": "90s" }
}
