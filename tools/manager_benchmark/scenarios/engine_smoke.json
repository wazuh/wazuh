{
  "name": "engine_smoke",
  "description": "Small agent-mode smoke test: a 4-agent Linux fleet running a single short syslog engine lane at a modest rate, no looping. Quick sanity check of the engine ingress path.",
  "mode": "agent",
  "defaults": {
    "cluster_name": "cluster01",
    "control": { "enabled": true, "keepalive_interval": "10s", "send_host_info": true, "startup_version": "5.0.0" }
  },
  "lanes": {
    "engine": [
      { "kind": "engine", "engine": "../sample_payloads/engine/syslog_short.log", "location": "syslog",
        "events_per_second": 100 }
    ]
  },
  "fleets": [
    { "name": "linux", "agents": 4, "first_id": 23000, "lanes": ["engine"],
      "start": { "osname": "Ubuntu", "osplatform": "ubuntu", "ostype": "linux", "osversion": "22.04", "architecture": "x86_64", "agentversion": "5.0.0" } }
  ],
  "pacing": { "concurrent_agents": 0, "requests_per_second": 0, "repeat_until": "0", "drain_timeout": "30s" },
  "expected": { "stateless": { "sent": { "eq": 4 }, "s202": { "eq": 4 }, "events_sent": { "eq": 200 } }, "control": { "startup_err": { "eq": 0 } } }
}
