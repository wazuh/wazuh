{
  "name": "fim_first_sync_windows",
  "description": "Single Windows fleet running a single FIM full_resync (first scan) with checksums, no follow-up delta. Windows twin of fim_first_sync_ubuntu for OS-comparison baselines.",
  "mode": "uds",
  "defaults": {
    "module": "fim",
    "option": "Sync",
    "cluster_name": "cluster01"
  },
  "lanes": {
    "fim": [
      { "kind": "full_resync", "module": "fim", "indices": ["wazuh-states-fim-files"],
        "documents": { "count": 800, "size_bytes": 512 } }
    ]
  },
  "fleets": [
    { "name": "windows", "agents": 8, "first_id": 11000, "lanes": ["fim"],
      "start": { "osname": "Windows 11", "osplatform": "windows", "ostype": "windows", "osversion": "10.0.22631", "architecture": "x86_64", "agentversion": "5.0.0" } }
  ],
  "pacing": { "concurrent_agents": 0, "requests_per_second": 0, "repeat_until": "0", "drain_timeout": "60s" }
}
