{
  "name": "contract_feed_not_ready_retry",
  "description": "Contract test for the feed-not-ready path: a VDFirst delta immediately followed by a checksum confirm, the pattern that hits 503+Retry-After while the vulnerability feed is still downloading. The sender re-sends the same buffer, bounded by --feed-timeout, until the feed becomes ready.",
  "mode": "uds",
  "defaults": {
    "module": "syscollector",
    "option": "VDFirst",
    "cluster_name": "cluster01",
    "cluster_node": "node01"
  },
  "lanes": {
    "vd": [
      { "kind": "delta", "module": "syscollector", "option": "VDFirst", "indices": ["wazuh-states-inventory-packages"],
        "documents": { "count": 50 } },
      { "kind": "checksum", "module": "syscollector", "indices": ["wazuh-states-inventory-packages"], "checksum": "correct" }
    ]
  },
  "fleets": [
    { "name": "linux", "agents": 4, "first_id": 30000, "lanes": ["vd"],
      "start": { "osname": "Ubuntu", "osplatform": "ubuntu", "ostype": "linux", "osversion": "22.04", "architecture": "x86_64", "agentversion": "5.0.0" } }
  ],
  "pacing": { "concurrent_agents": 0, "requests_per_second": 0, "repeat_until": "0", "drain_timeout": "60s" }
}
