{
  "name": "sca_delta_ubuntu",
  "description": "Linux fleet emitting a steady stream of SCA deltas (policy check-result updates), no initial full_resync, to measure sustained SCA delta cost.",
  "mode": "uds",
  "defaults": {
    "module": "sca",
    "option": "Sync",
    "cluster_name": "cluster01"
  },
  "lanes": {
    "sca": [
      { "kind": "delta", "module": "sca", "indices": ["wazuh-states-sca"],
        "documents": { "count": 20 }, "repeat_count": 40, "repeat_delay": "2s" }
    ]
  },
  "fleets": [
    { "name": "linux", "agents": 8, "first_id": 14000, "lanes": ["sca"],
      "start": { "osname": "Ubuntu", "osplatform": "ubuntu", "ostype": "linux", "osversion": "22.04", "architecture": "x86_64", "agentversion": "5.0.0" } }
  ],
  "pacing": { "concurrent_agents": 0, "requests_per_second": 0, "repeat_until": "0", "drain_timeout": "90s" }
}
