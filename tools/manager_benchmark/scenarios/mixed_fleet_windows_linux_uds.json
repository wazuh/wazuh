{
  "name": "mixed_fleet_windows_linux_uds",
  "description": "The uds-mode twin of mixed_fleet_windows_linux: the same inventory lanes straight to the module socket, with no engine lane and no /control (both are agent-mode paths). Run as a pair with the agent-mode scenario, the difference isolates the remoted relay cost (F9c-4).",
  "mode": "uds",
  "defaults": {
    "module": "syscollector",
    "option": "Sync",
    "cluster_name": "cluster01",
    "control": { "enabled": false }
  },
  "lanes": {
    "fim": [
      { "kind": "full_resync", "module": "fim", "indices": ["wazuh-states-fim-files"],
        "documents": { "count": 500, "size_bytes": 512 } },
      { "kind": "delta", "module": "fim", "indices": ["wazuh-states-fim-files"],
        "documents": { "count": 20, "size_bytes": 512 }, "repeat_count": 10, "repeat_delay": "3s" }
    ],
    "sca": [
      { "kind": "full_resync", "module": "sca", "indices": ["wazuh-states-sca"],
        "documents": { "count": 200, "size_bytes": 384 } },
      { "kind": "delta", "module": "sca", "indices": ["wazuh-states-sca"],
        "documents": { "count": 15 }, "repeat_count": 20, "repeat_delay": "5s", "initial_delay": "10s" }
    ],
    "syscollector": [
      { "kind": "full_resync", "module": "syscollector", "indices": ["wazuh-states-inventory-packages"],
        "documents": { "count": 300, "size_bytes": 256 } },
      { "kind": "checksum", "module": "syscollector", "indices": ["wazuh-states-inventory-packages"], "checksum": "correct" }
    ],
    "vd": [
      { "kind": "delta", "module": "syscollector", "option": "VDFirst", "indices": ["wazuh-states-inventory-packages"],
        "documents": { "count": 300, "size_bytes": 256 } },
      { "kind": "delta", "option": "VDSync", "indices": ["wazuh-states-inventory-packages"],
        "documents": { "count": 30 }, "repeat_count": 20, "repeat_delay": "5s", "initial_delay": "10s" }
    ]
  },
  "fleets": [
    { "name": "windows", "agents": 20, "first_id": 1000, "lanes": ["fim", "sca", "syscollector", "vd"],
      "start": { "osname": "Windows 11", "osplatform": "windows", "ostype": "windows", "osversion": "10.0.22631", "architecture": "x86_64", "agentversion": "5.0.0" } },
    { "name": "linux", "agents": 20, "first_id": 2000, "lanes": ["fim", "sca", "syscollector", "vd"],
      "start": { "osname": "Ubuntu", "osplatform": "ubuntu", "ostype": "linux", "osversion": "22.04", "architecture": "x86_64", "agentversion": "5.0.0" } }
  ],
  "pacing": { "concurrent_agents": 0, "requests_per_second": 0, "repeat_until": "0", "drain_timeout": "90s" }
}
