{
  "name": "control_notify_storm",
  "description": "Agent-mode /control keepalive storm: a large 50-agent fleet with an aggressive 2s keepalive interval and host-info reporting enabled. The single inventory lane is deliberately tiny AND spaced by initial_delay, so that replaying it under repeat_until cannot turn the run into a session storm -- the measured pressure is the keepalive traffic itself.",
  "mode": "agent",
  "defaults": {
    "cluster_name": "cluster01",
    "control": {
      "enabled": true,
      "keepalive_interval": "2s",
      "send_host_info": true,
      "startup_version": "5.0.0"
    }
  },
  "lanes": {
    "syscollector": [
      {
        "kind": "delta",
        "module": "syscollector",
        "indices": [
          "wazuh-states-inventory-packages"
        ],
        "documents": {
          "count": 1
        },
        "repeat_count": 1,
        "initial_delay": "10s"
      }
    ]
  },
  "fleets": [
    {
      "name": "linux",
      "agents": 50,
      "first_id": 25000,
      "lanes": [
        "syscollector"
      ],
      "start": {
        "osname": "Ubuntu",
        "osplatform": "ubuntu",
        "ostype": "linux",
        "osversion": "22.04",
        "architecture": "x86_64",
        "agentversion": "5.0.0"
      }
    }
  ],
  "pacing": {
    "concurrent_agents": 0,
    "requests_per_second": 0,
    "repeat_until": "60s",
    "drain_timeout": "30s"
  }
}
