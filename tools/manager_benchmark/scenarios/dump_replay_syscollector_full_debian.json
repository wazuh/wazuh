{
  "name": "dump_replay_syscollector_full_debian",
  "description": "Linux (Debian) fleet replaying a large syscollector inventory dump: a big full_resync (2000 documents) followed by a slow, sparse delta stream. Measures large-dataset first-scan cost and its aftermath.",
  "mode": "uds",
  "defaults": {
    "module": "syscollector",
    "option": "Sync",
    "cluster_name": "cluster01"
  },
  "lanes": {
    "syscollector": [
      { "kind": "full_resync", "module": "syscollector", "indices": ["wazuh-states-inventory-packages"],
        "documents": { "count": 2000, "size_bytes": 256 } },
      { "kind": "delta", "module": "syscollector", "indices": ["wazuh-states-inventory-packages"],
        "documents": { "count": 50 }, "repeat_count": 8, "repeat_delay": "10s", "initial_delay": "20s" }
    ]
  },
  "fleets": [
    { "name": "linux", "agents": 10, "first_id": 21000, "lanes": ["syscollector"],
      "start": { "osname": "Debian GNU/Linux", "osplatform": "debian", "ostype": "linux", "osversion": "12", "architecture": "x86_64", "agentversion": "5.0.0" } }
  ],
  "pacing": { "concurrent_agents": 0, "requests_per_second": 0, "repeat_until": "0", "drain_timeout": "120s" }
}
