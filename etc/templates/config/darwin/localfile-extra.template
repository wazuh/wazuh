  <localfile>
    <location>macos</location>
    <log_format>macos</log_format>
    <query type="trace,log,activity" level="info">(process == "sudo") or (process == "sessionlogoutd" and eventMessage contains "logout is complete.") or (process == "sshd") or (process == "sshd-session") or (process == "sshd-auth") or (process == "tccd" and eventMessage contains "Update Access Record") or (eventMessage contains "SessionAgentNotificationCenter") or (process == "screensharingd" and eventMessage contains "Authentication") or (process == "securityd" and eventMessage contains "Session" and subsystem == "com.apple.securityd") or (process == "authd" and subsystem == "com.apple.Authorization" and (eventMessage contains "system.login.console" or eventMessage contains "builtin:login-success" or eventMessage contains "Failed authorizing")) or (process == "authorizationhost" and (eventMessage contains "authtok is incorrect" or eventMessage contains "Failed to authenticate")) or (process == "loginwindow" and (eventMessage contains "attempting login for user" or eventMessage contains "is logged in" or eventMessage contains "loginwindow.loginInitiated" or eventMessage contains "loginwindow.logoutInitiated"))</query>
  </localfile>
