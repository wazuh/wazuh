#!/bin/sh
# preinst script for wazuh-agent

set -e

# configuration variables
DIR="/var/ossec"
WAZUH_TMP_DIR="${DIR}/packages_files/agent_config_files"

# environment configuration
mkdir -p ${WAZUH_TMP_DIR}

# in_dir DIR COMMAND...: runs COMMAND in a subshell whose working directory is DIR, only when no
# link leads there. A name COMMAND resolves relative to it then stays in that directory, whatever
# happens to DIR's path afterwards. etc/ is writable by the wazuh group, which could otherwise turn
# a directory in it into a link to anywhere.
REAL_DIR=$(cd -P ${DIR} 2> /dev/null && pwd -P)
in_dir() {
    (cd -P -- "$1" 2> /dev/null && [ "$(pwd -P)" = "${REAL_DIR}${1#"${DIR}"}" ] && shift && "$@")
}

# Copies the working directory's entries (etc/shared/, through in_dir) to ${WAZUH_TMP_DIR}/group.
backup_shared_files() {
    set -- ./*
    if [ -e "$1" ] || [ -L "$1" ]; then
        mkdir -p ${WAZUH_TMP_DIR}/group
        cp -a "$@" ${WAZUH_TMP_DIR}/group/
    fi
}

case "$1" in
    install|upgrade)

        if [ "$1" = "upgrade" ]; then

            if [ ! -d "$DIR" ]; then
                echo "Error: Directory $DIR does not exist. Cannot perform upgrade" >&2
                exit 1
            fi

            # Get version information
            if [ -f "${DIR}/bin/wazuh-control" ]; then
                OLD_VERSION=`${DIR}/bin/wazuh-control info -v 2>/dev/null`
                MAJOR=$(echo $OLD_VERSION | cut -dv -f2 | cut -d. -f1)
                MINOR=$(echo $OLD_VERSION | cut -dv -f2 | cut -d. -f2)
            elif [ -f ${DIR}/VERSION.json ]; then
                OLD_VERSION=`grep -oP '(?<="version": ")[^"]*' ${DIR}/VERSION.json 2>/dev/null`
                MAJOR=$(echo $OLD_VERSION | cut -d. -f1)
                MINOR=$(echo $OLD_VERSION | cut -d. -f2)
            fi

            # Validate upgrade constraints for Agent
            ERROR_TYPE=""

            # Determine if upgrade should be blocked
            if [ -z "$MAJOR" ] || [ -z "$MINOR" ]; then
                ERROR_TYPE="no_version"
                ERROR_TITLE="Cannot detect current version"
                ERROR_MESSAGE="Unable to detect the currently installed Wazuh version."
            elif [ "$MAJOR" -lt 4 ] || ([ "$MAJOR" -eq 4 ] && [ "$MINOR" -lt 14 ]); then
                ERROR_TYPE="unsupported"
                ERROR_TITLE="Incompatible version detected"
                ERROR_MESSAGE="Current version: $OLD_VERSION
Target version:  5.0.0

Upgrade to Wazuh 5.0.0 is only supported from version 4.14.0 or later."
            fi

            # If any error was detected, show message and block
            if [ -n "$ERROR_TYPE" ]; then
                cat <<EOF >&2
═════════════════════════════════════════════════════════════════
  UPGRADE BLOCKED: $ERROR_TITLE
═════════════════════════════════════════════════════════════════

$ERROR_MESSAGE

Required action:
  1. Upgrade to version 4.14.0 or later first
  2. Then upgrade to 5.0.0

For more information, visit:
  https://documentation.wazuh.com/current/upgrade-guide/
═════════════════════════════════════════════════════════════════
EOF
                echo -n "1" > ${DIR}/var/upgrade/upgrade_result
                exit 1
            fi

            if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1 && systemctl is-active --quiet wazuh-agent > /dev/null 2>&1; then
                systemctl stop wazuh-agent.service > /dev/null 2>&1
                touch ${WAZUH_TMP_DIR}/wazuh.restart
            elif command -v service > /dev/null 2>&1 && service wazuh-agent status 2>/dev/null | grep "is running" > /dev/null 2>&1; then
                service wazuh-agent stop > /dev/null 2>&1
                touch ${WAZUH_TMP_DIR}/wazuh.restart
            elif ${DIR}/bin/wazuh-control status 2>/dev/null | grep "is running" > /dev/null 2>&1; then
                touch ${WAZUH_TMP_DIR}/wazuh.restart
            fi
            ${DIR}/bin/wazuh-control stop > /dev/null 2>&1

            # Remove old databases if upgrading from pre 5.X to 5.X
            if [ $MAJOR -lt 5 ]; then
                if [ -f ${DIR}/queue/syscollector/db/local.db ]; then
                    rm -f ${DIR}/queue/syscollector/db/local.db
                fi
                if [ -f ${DIR}/queue/fim/db/fim.db ]; then
                    rm -f ${DIR}/queue/fim/db/fim.db
                fi
            fi

            if [ -d ${DIR}/logs/ossec ]; then
                mv ${DIR}/logs/ossec ${DIR}/logs/wazuh
            fi

            if [ -d ${DIR}/queue/ossec ]; then
                mv ${DIR}/queue/ossec ${DIR}/queue/sockets
            fi

            # Remove execq socket so when restarting the agent it is regenerated in its new location
            if [ -S ${DIR}/queue/alerts/execq ]; then
                rm -f ${DIR}/queue/alerts/execq
            fi

            # Remove deprecated cfgaq socket
            if [ -S ${DIR}/queue/alerts/cfgaq ]; then
                rm -f ${DIR}/queue/alerts/cfgaq
            fi

            # Remove alerts folder
            if [ -d ${DIR}/queue/alerts ]; then
                rm -rf ${DIR}/queue/alerts
            fi
        fi

        if [ ! -z "$2" ] && [ ! -f ${DIR}/etc/ossec.conf ] ; then
            touch ${WAZUH_TMP_DIR}/create_conf
        fi

        # Delete old service
        if [ -f /etc/init.d/ossec ]; then
            rm /etc/init.d/ossec
        fi

        # Back up the configuration files postinst restores. etc/ is writable by the wazuh group: a
        # link there is not ours to back up, and cp would carry its target's content into the
        # restored file. -P keeps one swapped in after the check a link, which postinst skips.
        # An interrupted upgrade leaves the unpack placeholders in ${DIR}/etc (an empty
        # client.keys, an ossec.conf without a <client> block); re-running dpkg -i runs this
        # script again and must not copy them over the backup taken by the first run (#40246):
        # the first backup wins, and postinst consumes it on restore.
        for CONF_FILE in client.keys local_internal_options.conf ossec.conf; do
            if [ -f ${DIR}/etc/${CONF_FILE} ] && [ ! -L ${DIR}/etc/${CONF_FILE} ] \
                && [ ! -e ${WAZUH_TMP_DIR}/${CONF_FILE} ]; then
                cp -fpP ${DIR}/etc/${CONF_FILE} ${WAZUH_TMP_DIR}/${CONF_FILE}
            fi
        done

        # etc/shared/ sits in etc/, so it may be a link to another directory: its files are copied
        # from inside it, once no link led there. cp -a keeps a link found among them a link.
        # The same first-backup-wins rule applies: a re-run after an interrupted upgrade must
        # not overwrite ${WAZUH_TMP_DIR}/group either (#40246).
        if [ -d ${DIR}/etc/shared ] && [ ! -d ${WAZUH_TMP_DIR}/group ]; then
            in_dir ${DIR}/etc/shared backup_shared_files \
                || echo "WARNING: ${DIR}/etc/shared was not backed up: it is a link, or it could not be copied." >&2
        fi
    ;;

    abort-upgrade)

    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1

    ;;

esac

exit 0
