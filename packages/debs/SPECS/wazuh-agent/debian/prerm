#!/bin/sh
# prerm script for wazuh-manager

set -e

DIR="/var/ossec"
WAZUH_TMP_DIR="${DIR}/packages_files/agent_config_files"

# environment configuration
if [ ! -d ${WAZUH_TMP_DIR} ]; then
    mkdir -p ${WAZUH_TMP_DIR}
else
    rm -rf ${WAZUH_TMP_DIR}
    mkdir -p ${WAZUH_TMP_DIR}
fi

# Function to extract package_uninstallation value from XML
get_package_uninstallation_value() {
  local file_path="$1"
  local value=$(sed -n '/<anti_tampering>/,/<\/anti_tampering>/p' "$file_path" | grep -oP '(?<=<package_uninstallation>).*?(?=</package_uninstallation>)' | tr -d '\n')
  echo "$value"
}

# Function to check anti-tampering configuration
check_anti_tampering() {
  local config_file
  local uninstall_validation_needed=""

  if [ -f "${DIR}/etc/shared/agent.conf" ]; then
    config_file="${DIR}/etc/shared/agent.conf"
    uninstall_validation_needed=$(get_package_uninstallation_value "$config_file")
  fi

  if [ -z "$uninstall_validation_needed" ] && [ -f "${DIR}/etc/ossec.conf" ]; then
    config_file="${DIR}/etc/ossec.conf"
    uninstall_validation_needed=$(get_package_uninstallation_value "$config_file")
  fi

  if [ "$uninstall_validation_needed" = "yes" ]; then
    return 0
  else
    return 1
  fi
}

# Prints the value file $1 gives KEY $2 on its last "[export ]KEY=value" line, or $3 when the file
# does not set it. Read as the shell reads a plain assignment: a quoted value without its quotes, an
# unquoted one up to the first blank, and neither with a trailing comment. Nothing in the file is run.
env_file_value() {
  local value
  value=$(sed -n "s/^[[:space:]]*\(export[[:space:]][[:space:]]*\)\{0,1\}$2=//p" "$1" | tail -n 1 \
    | sed -e 's/^"\(.*\)"[[:space:]]*\(#.*\)\{0,1\}$/\1/' -e t \
          -e "s/^'\(.*\)'[[:space:]]*\(#.*\)\{0,1\}\$/\1/" -e t \
          -e 's/[[:space:]].*$//')
  printf '%s\n' "${value:-$3}"
}

# Takes the VALIDATION_* variables from etc/uninstall_validation.env, which overrides the
# environment. etc/ is writable by the wazuh group, so the file is read as data, and only when it
# is a regular file root owns and nobody else can write. It is checked and read through a hard link
# made in a directory only root can enter: ln neither opens the file (cp would block on a FIFO) nor
# follows a link, and the file it pins cannot be swapped after the check.
load_uninstall_validation_env() {
  local env_file="${DIR}/etc/uninstall_validation.env"
  local link_dir

  if [ ! -e "${env_file}" ] && [ ! -L "${env_file}" ]; then
    echo "INFO: Uninstall configuration file not found, using environment variables."
    return
  fi
  link_dir=$(mktemp -d "${DIR}/.uninstall-validation.XXXXXX") || exit 1
  if ! ln -P "${env_file}" "${link_dir}/env" 2> /dev/null || [ -L "${link_dir}/env" ] || [ ! -f "${link_dir}/env" ] \
      || [ -z "$(find "${link_dir}/env" -user 0 ! -perm -0020 ! -perm -0002)" ]; then
    echo "WARNING: ${env_file} is not a regular file owned by root and writable only by it; ignoring it and using environment variables."
  else
    VALIDATION_HOST=$(env_file_value "${link_dir}/env" VALIDATION_HOST "${VALIDATION_HOST}")
    VALIDATION_TOKEN=$(env_file_value "${link_dir}/env" VALIDATION_TOKEN "${VALIDATION_TOKEN}")
    VALIDATION_LOGIN=$(env_file_value "${link_dir}/env" VALIDATION_LOGIN "${VALIDATION_LOGIN}")
    VALIDATION_SSL_VERIFY=$(env_file_value "${link_dir}/env" VALIDATION_SSL_VERIFY "${VALIDATION_SSL_VERIFY}")
  fi
  rm -rf "${link_dir}"
}

# Function to validate uninstallation
validate_uninstall() {
  load_uninstall_validation_env

  # Check if the VALIDATION_HOST variables are set
  if [ -z "$VALIDATION_HOST" ]; then
    echo "ERROR: Validation host not provided. Uninstallation cannot be continued."
    exit 1
  fi

  # Validate uninstallation. Each value is passed as one argument, never split into more.
  if [ -n "$VALIDATION_TOKEN" ] && [ -n "$VALIDATION_LOGIN" ]; then
    set -- "--uninstall-auth-token=${VALIDATION_TOKEN}" "--uninstall-auth-login=${VALIDATION_LOGIN}"
  elif [ -n "$VALIDATION_TOKEN" ]; then
    set -- "--uninstall-auth-token=${VALIDATION_TOKEN}"
  elif [ -n "$VALIDATION_LOGIN" ]; then
    set -- "--uninstall-auth-login=${VALIDATION_LOGIN}"
  else
    echo "ERROR: Validation login or token not provided. Uninstallation cannot be continued."
    exit 1
  fi

  if "${DIR}/bin/wazuh-agentd" "$@" "--uninstall-auth-host=${VALIDATION_HOST}" "--uninstall-ssl-verify=${VALIDATION_SSL_VERIFY}"; then
    echo "INFO: Uninstallation authorized, continuing..."
  else
    echo "ERROR: Uninstallation not authorized, aborting..."
    exit 1
  fi
}

case "$1" in
    upgrade|deconfigure)

      # Stop the services before uninstalling the package
      if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1 && systemctl is-active --quiet wazuh-agent > /dev/null 2>&1; then
          systemctl stop wazuh-agent > /dev/null 2>&1
          touch ${WAZUH_TMP_DIR}/wazuh.restart
      elif command -v service > /dev/null 2>&1 && service wazuh-agent status 2>/dev/null | grep "running" > /dev/null 2>&1; then
          service wazuh-agent stop > /dev/null 2>&1
          touch ${WAZUH_TMP_DIR}/wazuh.restart
      fi
      if [ -f ${DIR}/bin/wazuh-control ]; then
        ${DIR}/bin/wazuh-control stop > /dev/null 2>&1
      fi

    ;;

    remove)

      # Check if anti-tampering is enabled
      if check_anti_tampering; then
        validate_uninstall
      fi

      # Stop the services before uninstalling the package
      # Check for systemd
      if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1 && systemctl is-active --quiet wazuh-agent > /dev/null 2>&1; then
          systemctl stop wazuh-agent > /dev/null 2>&1
      # Check for SysV
      elif command -v service > /dev/null 2>&1 && service wazuh-agent status 2>/dev/null | grep "running" > /dev/null 2>&1; then
          service wazuh-agent stop > /dev/null 2>&1
      fi
      if [ -f ${DIR}/bin/wazuh-control ]; then
        ${DIR}/bin/wazuh-control stop > /dev/null 2>&1
      fi

      # Save the conffiles, for postrm to keep as .save. tmp/ is writable by the wazuh group, which
      # could leave a link at tmp/conffiles for mkdir -p and cp to follow: whatever is there goes,
      # and a plain mkdir makes the directory anew, failing if anything took its place meanwhile.
      # Root owns it, and the sticky bit on tmp/ keeps the group from replacing it until postrm.
      rm -rf ${DIR}/tmp/conffiles
      if mkdir -m 0750 ${DIR}/tmp/conffiles 2> /dev/null; then
        # A link in etc/ is not ours to save: skipped, and -P keeps one swapped in meanwhile a link.
        for CONF_FILE in client.keys local_internal_options.conf ossec.conf; do
          if [ -f ${DIR}/etc/${CONF_FILE} ] && [ ! -L ${DIR}/etc/${CONF_FILE} ]; then
            cp -pP ${DIR}/etc/${CONF_FILE} ${DIR}/tmp/conffiles
          fi
        done
      else
        echo "WARNING: could not create ${DIR}/tmp/conffiles; the configuration files will not be kept as .save." >&2
      fi

    ;;

    failed-upgrade)
      if [ -f ${DIR}/bin/wazuh-control ]; then
        ${DIR}/bin/wazuh-control stop > /dev/null 2>&1
      fi
    ;;

    *)
      echo "prerm called with unknown argument \`$1'" >&2
      exit 1
    ;;

esac

exit 0
