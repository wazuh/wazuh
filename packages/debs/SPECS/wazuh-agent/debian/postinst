#!/bin/sh
# postinst script for wazuh-agent
# Wazuh, Inc 2015

set -e

case "$1" in
    configure)

    OS=$(. /etc/os-release && printf '%s\n' "$ID" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')
    VER=$(. /etc/os-release && echo "${VERSION_ID}")
    DIR="/var/ossec"
    USER="wazuh"
    GROUP="wazuh"
    WAZUH_GLOBAL_TMP_DIR="${DIR}/packages_files"
    WAZUH_TMP_DIR="${WAZUH_GLOBAL_TMP_DIR}/agent_config_files"
    SCRIPTS_DIR="${WAZUH_GLOBAL_TMP_DIR}/agent_installation_scripts"
    SCA_BASE_DIR="${SCRIPTS_DIR}/sca"

    OSMYSHELL="/sbin/nologin"

    # etc/ and etc/shared/ are writable by ${GROUP} and logs/ belongs to ${USER}, so anything in them
    # may be a link the service account planted, and cp, chmod and chown follow links. A file root
    # writes there is built in ${WAZUH_TMP_DIR} (root only) and renamed into place: a rename
    # replaces a link instead of following it.
    mkdir -p ${WAZUH_TMP_DIR}

    # install_file SOURCE MODE OWNER:GROUP DEST: moves SOURCE, already in ${WAZUH_TMP_DIR}, to DEST.
    install_file() {
        chmod "$2" "$1" && chown "$3" "$1" && mv -fT "$1" "$4"
    }

    # in_dir DIR COMMAND...: runs COMMAND in a subshell whose working directory is DIR, only when no
    # link leads there. A name COMMAND resolves relative to it then stays in that directory,
    # whatever happens to DIR's path afterwards.
    REAL_DIR=$(cd -P ${DIR} && pwd -P)
    in_dir() {
        (cd -P -- "$1" 2> /dev/null && [ "$(pwd -P)" = "${REAL_DIR}${1#"${DIR}"}" ] && shift && "$@")
    }

    # zero_fill_plain_file FILE: overwrites FILE with zeros when it is a plain, non-empty file with no
    # other link, so nothing but FILE's own bytes is touched.
    zero_fill_plain_file() {
        if [ -f "$1" ] && [ ! -L "$1" ] && [ -n "$(find "$1" -links 1)" ] && [ -s "$1" ]; then
            dd if=/dev/zero of="$1" bs=1 count=$(wc -c < "$1") conv=notrunc > /dev/null 2>&1 || true
        fi
    }

    # restore_failed TARGET COPY: warns that TARGET could not be restored, and keeps ${WAZUH_TMP_DIR},
    # which holds COPY, from being deleted at the end.
    RESTORE_FAILED=""
    restore_failed() {
        echo "WARNING: could not restore $1; its copy is kept at $2." >&2
        RESTORE_FAILED=yes
    }

    # restore_conf_file NAME: puts back the copy of etc/NAME preinst took, root:${GROUP} 0640. A link
    # in its place is one swapped in while preinst copied, and is dropped.
    restore_conf_file() {
        if [ -L ${WAZUH_TMP_DIR}/$1 ]; then
            rm -f ${WAZUH_TMP_DIR}/$1
        elif [ -f ${WAZUH_TMP_DIR}/$1 ]; then
            install_file ${WAZUH_TMP_DIR}/$1 640 root:${GROUP} ${DIR}/etc/$1 \
                || restore_failed ${DIR}/etc/$1 ${WAZUH_TMP_DIR}/$1
        fi
    }

    # Not shipped under /etc (see debian/rules): only hosts without systemd get the init.d script.
    if [ -d /run/systemd/system ]; then
        rm -f /etc/init.d/wazuh-agent
    else
        install -m 0755 ${SCRIPTS_DIR}/src/init/templates/wazuh-debian.init /etc/init.d/wazuh-agent
    fi

    if [ ! -f ${OSMYSHELL} ]; then
        if [ -f "/bin/false" ]; then
            OSMYSHELL="/bin/false"
        fi
    fi

    if ! getent group ${GROUP} > /dev/null 2>&1; then
        groupadd --system ${GROUP} > /dev/null 2>&1
    fi
    if ! getent passwd ${USER} > /dev/null 2>&1; then
        useradd --system --home-dir ${DIR} --shell ${OSMYSHELL} --gid ${GROUP} --no-create-home ${USER} > /dev/null 2>&1
    fi

    # Generated in ${WAZUH_TMP_DIR} and moved into place. Not under the name ossec.conf there: that
    # is preinst's copy of the current one, restored below.
    CONF_STAGE=${WAZUH_TMP_DIR}/ossec.conf.generated
    if [ -z "$2" ] || [ -f ${WAZUH_TMP_DIR}/create_conf ] ; then

        ${SCRIPTS_DIR}/src/init/gen_wazuh.sh conf agent ${OS} ${VER} ${DIR} > ${CONF_STAGE}
        ${SCRIPTS_DIR}/src/init/add_localfiles.sh ${DIR} >> ${CONF_STAGE}
        install_file ${CONF_STAGE} 640 root:${GROUP} ${DIR}/etc/ossec.conf
    else
        ${SCRIPTS_DIR}/src/init/gen_wazuh.sh conf agent ${OS} ${VER} ${DIR} > ${CONF_STAGE}
        install_file ${CONF_STAGE} 640 root:${GROUP} ${DIR}/etc/ossec.conf.new
    fi

    # For the etc dir
    if [ -f /etc/localtime ]; then
        cp -pL /etc/localtime ${WAZUH_TMP_DIR}/localtime && \
            install_file ${WAZUH_TMP_DIR}/localtime 640 root:${GROUP} ${DIR}/etc/localtime
    fi

    # Remove deprecated binaries
    if [ -f ${DIR}/bin/agent-auth ]; then
        rm -f ${DIR}/bin/agent-auth
    fi

    # #39064: drop the fleet-wide enrollment password. It is one secret that enrols any endpoint,
    # left at rest on every one of them; 5.0 replaces it with an enrollment token. An agent that
    # enrols through POST /enroll also receives a per-agent re-enrollment secret; one enrolled
    # before the upgrade holds none, so once the file is gone it has no unattended recovery left.
    # A fresh 5.0 install never creates the file, so without this an upgraded host -- the
    # longest-running one in the estate, which is exactly where the exposure matters most -- would
    # keep it for ever.
    #
    # Upgrade only ($2 is the previously configured version, empty on a fresh install), and once:
    # this is a package decision, not a runtime one, so it must not depend on the agent ever
    # reaching a manager. Overwritten before it is unlinked, because the bytes are a secret.
    #
    # etc/ is writable by ${GROUP}, which could leave a link at etc/authd.pass for dd to write
    # zeros through. The entry is renamed into ${WAZUH_TMP_DIR} first (a rename moves a link, never
    # its target), and only zeroed there when it is a plain file with no other link.
    if [ -n "$2" ] && [ -f ${DIR}/etc/authd.pass ]; then
        if mv -f ${DIR}/etc/authd.pass ${WAZUH_TMP_DIR}/authd.pass; then
            zero_fill_plain_file ${WAZUH_TMP_DIR}/authd.pass
            rm -f ${WAZUH_TMP_DIR}/authd.pass
            echo "wazuh-agent: removed the fleet-wide enrollment password at ${DIR}/etc/authd.pass. 5.0 enrols with an enrollment token (WAZUH_ENROLLMENT_TOKEN); an agent enrolled before the upgrade holds no re-enrollment secret and must be re-pointed with a token if the manager stops recognising its key."
        fi
    fi

    # Restore client.keys, ossec.conf and the internal options
    for CONF_FILE in client.keys ossec.conf local_internal_options.conf; do
        restore_conf_file ${CONF_FILE}
    done

    # Install the SCA files
    if [ -d "${SCA_BASE_DIR}" ]; then
        . ${SCRIPTS_DIR}/src/init/dist-detect.sh

        SCA_DIR="${DIST_NAME}/${DIST_VER}"

        SCA_TMP_DIR="${SCA_BASE_DIR}/${DIST_NAME}/${DIST_VER}"
        mkdir -p ${DIR}/ruleset/sca

        # Install the configuration files needed for this hosts
        if [ -r "${SCA_BASE_DIR}/${DIST_NAME}/${DIST_VER}/${DIST_SUBVER}/sca.files" ]; then
            SCA_TMP_DIR="${SCA_BASE_DIR}/${DIST_NAME}/${DIST_VER}/${DIST_SUBVER}"
        elif [ -r "${SCA_BASE_DIR}/${DIST_NAME}/${DIST_VER}/sca.files" ]; then
            SCA_TMP_DIR="${SCA_BASE_DIR}/${DIST_NAME}/${DIST_VER}"
        elif [ -r "${SCA_BASE_DIR}/${DIST_NAME}/sca.files" ]; then
            SCA_TMP_DIR="${SCA_BASE_DIR}/${DIST_NAME}"
        else
            SCA_TMP_DIR="${SCA_BASE_DIR}/generic"
        fi

        SCA_TMP_FILE="${SCA_TMP_DIR}/sca.files"

        if [ -r ${SCA_TMP_FILE} ]; then
            rm -f ${DIR}/ruleset/sca/* || true

            for sca_file in $(cat ${SCA_TMP_FILE}); do
                mv ${SCA_BASE_DIR}/${sca_file} ${DIR}/ruleset/sca
            done
        fi

        # Set correct permissions, owner and group. ruleset directory may be empty.
        if [ -n "$(ls -A ${DIR}/ruleset/sca/)" ]; then
            chmod --recursive u=rwX,g=rX,o= ${DIR}/ruleset/sca/
            chown --recursive root:${GROUP} ${DIR}/ruleset/sca/
        fi
        # Delete the temporary directory
        rm -rf ${SCA_BASE_DIR}

    fi

    # Restore the etc/shared/ files preinst copied, from inside the directory as preinst did.
    # --remove-destination replaces a link planted at a destination instead of writing (and, with
    # -a, chowning) through it.
    restore_shared_files() {
        cp -a --remove-destination ${WAZUH_TMP_DIR}/group/* .
    }
    if [ -d ${WAZUH_TMP_DIR}/group ]; then
        if in_dir ${DIR}/etc/shared restore_shared_files; then
            rm -rf ${WAZUH_TMP_DIR}/group
        else
            restore_failed ${DIR}/etc/shared ${WAZUH_TMP_DIR}/group
        fi
    fi

    # logs/ belongs to ${USER}, which could leave a link or a FIFO at the log's name: touch, chown
    # and chmod follow a link as root, and opening a FIFO blocks dpkg. The name is never opened. A
    # regular file only gets chown -h; anything else is replaced by an empty log built in
    # ${WAZUH_TMP_DIR} and renamed over it.
    if [ -f ${DIR}/logs/active-responses.log ] && [ ! -L ${DIR}/logs/active-responses.log ]; then
        chown -h ${USER}:${GROUP} ${DIR}/logs/active-responses.log 2> /dev/null || true
    else
        { : > ${WAZUH_TMP_DIR}/active-responses.log \
            && install_file ${WAZUH_TMP_DIR}/active-responses.log 0660 ${USER}:${GROUP} ${DIR}/logs/active-responses.log; } \
            || echo "WARNING: could not create ${DIR}/logs/active-responses.log." >&2
    fi

    # Check if SELinux is installed and enabled
    if command -v getenforce > /dev/null 2>&1 && command -v semodule > /dev/null 2>&1; then
        if [ $(getenforce) !=  "Disabled" ]; then
            semodule -i ${DIR}/var/selinux/wazuh.pp
            semodule -e wazuh
        fi
    fi

    # Register and configure agent if Wazuh environment variables are defined
    if [ -z "$2" ] || [ -f ${WAZUH_TMP_DIR}/create_conf ] ; then
        ${SCRIPTS_DIR}/src/init/register_configure_agent.sh ${DIR} > /dev/null || :
    else
        # An upgrade keeps its configuration; only WAZUH_ENROLLMENT_TOKEN is applied.
        ${SCRIPTS_DIR}/src/init/register_configure_agent.sh ${DIR} upgrade > /dev/null || :
    fi

    # Restoring file permissions
    ${SCRIPTS_DIR}/restore-permissions.sh > /dev/null 2>&1 || :

    if [ -f /etc/systemd/system/wazuh-agent.service ]; then
        rm -f /etc/systemd/system/wazuh-agent.service
        if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
            systemctl daemon-reload > /dev/null 2>&1
        fi
    fi

    # Remove old ossec user and group if exists and change ownwership of files
    if getent group ossec > /dev/null 2>&1; then
        find ${DIR}/ -group ossec -user root -exec chown root:wazuh {} \; > /dev/null 2>&1 || true
        if getent passwd ossec > /dev/null 2>&1; then
            find ${DIR}/ -group ossec -user ossec -exec chown wazuh:wazuh {} \; > /dev/null 2>&1 || true
            userdel ossec > /dev/null 2>&1
        fi
        if getent passwd ossecm > /dev/null 2>&1; then
            find ${DIR}/ -group ossec -user ossecm -exec chown wazuh:wazuh {} \; > /dev/null 2>&1 || true
            userdel ossecm > /dev/null 2>&1
        fi
        if getent passwd ossecr > /dev/null 2>&1; then
            find ${DIR}/ -group ossec -user ossecr -exec chown wazuh:wazuh {} \; > /dev/null 2>&1 || true
            userdel ossecr > /dev/null 2>&1
        fi
        if getent group ossec > /dev/null 2>&1; then
            groupdel ossec > /dev/null 2>&1
        fi
    fi

    find ${DIR} -nogroup -exec chgrp ${GROUP} {} \; > /dev/null 2>&1
    find ${DIR} -nouser -exec chown ${USER} {} \; > /dev/null 2>&1

    if [ ! -z "$2" ]; then
        if [ -f ${WAZUH_TMP_DIR}/wazuh.restart ] ; then
            if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
                systemctl daemon-reload > /dev/null 2>&1
                systemctl restart wazuh-agent.service > /dev/null 2>&1
            elif command -v service > /dev/null 2>&1 ; then
                service wazuh-agent restart > /dev/null 2>&1
            else
                ${DIR}/bin/wazuh-control restart > /dev/null 2>&1
            fi
        fi
    fi

    # Delete installation scripts
    if [ -d ${SCRIPTS_DIR} ]; then
        rm -rf ${SCRIPTS_DIR}
    fi

    # Delete tmp directory, unless it holds the copy of something that could not be restored
    if [ -d ${WAZUH_TMP_DIR} ] && [ -z "${RESTORE_FAILED}" ]; then
        rm -rf ${WAZUH_TMP_DIR}
    fi

    # If the parent directory is empty, delete it
    if [ -z "$(ls -A ${WAZUH_GLOBAL_TMP_DIR})" ]; then
        rm -rf ${WAZUH_GLOBAL_TMP_DIR}
    fi

    ;;


    abort-upgrade|abort-remove|abort-deconfigure)

    ;;


    *)
        echo "postinst called with unknown argument \`$1'" >2
        exit 1
    ;;

esac

exit 0
