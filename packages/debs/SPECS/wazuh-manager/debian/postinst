#!/bin/sh
# postinst script for Wazuh
# Wazuh, Inc 2015
set -e
case "$1" in
    configure)

    # The distribution and version only name the generated configuration's header comment.
    if [ -r /etc/os-release ]; then
        . /etc/os-release
        OS=${ID:-linux}
        VER=${VERSION_ID:-0}
    else
        OS="linux"
        VER="0"
    fi
    DIR="/var/wazuh-manager"
    # The configuration directory is fixed, outside the installation directory.
    CONF_DIR="/etc/wazuh-manager"
    USER="wazuh-manager"
    GROUP="wazuh-manager"
    WAZUH_GLOBAL_TMP_DIR="${DIR}/packages_files"
    WAZUH_TMP_DIR="${WAZUH_GLOBAL_TMP_DIR}/manager_config_files"
    WAZUH_PRESERVE_DIR="${WAZUH_GLOBAL_TMP_DIR}/manager_upgrade_preserve"
    OSMYSHELL="/sbin/nologin"
    SCRIPTS_DIR="${WAZUH_GLOBAL_TMP_DIR}/manager_installation_scripts"

    # ${CONF_DIR}, logs/, queue/db/ and api/configuration/ are writable by ${GROUP}, so anything in
    # them may be a link the service account planted, and chmod has no -h. Nothing here changes a
    # mode there as root: a file root creates is built in ${WAZUH_TMP_DIR} (root only) and renamed
    # into place (rename replaces a link, never follows it); a file ${USER} owns gets chown -h and
    # then a chmod run as ${USER}, which fails on anything else. chroot --userspec (coreutils)
    # switches user; the command then re-enters the working directory in_dir() verified (by path:
    # --skip-chdir needs coreutils 8.23, and a swapped path could only aim ${USER} at its own files).
    as_service_user() {
        chroot --userspec=${USER}:${GROUP} / sh -c 'cd -- "$1" && shift && exec "$@"' as_service_user "$(pwd -P)" "$@"
    }

    # install_file SOURCE MODE OWNER:GROUP DEST: moves SOURCE, already in ${WAZUH_TMP_DIR}, to DEST.
    install_file() {
        chmod "$2" "$1" && chown "$3" "$1" && mv -fT "$1" "$4"
    }

    # in_dir DIR COMMAND...: runs COMMAND with DIR as its working directory, only when no link
    # leads there. A name relative to it cannot then be redirected by swapping a directory above.
    REAL_DIR=$(cd -P ${DIR} && pwd -P)
    in_dir() {
        (cd -P -- "$1" 2> /dev/null && [ "$(pwd -P)" = "${REAL_DIR}${1#"${DIR}"}" ] && shift && "$@")
    }
    # in_conf_dir DIR COMMAND...: in_dir() for a directory under ${CONF_DIR}.
    REAL_CONF_DIR=$(cd -P ${CONF_DIR} 2> /dev/null && pwd -P) || REAL_CONF_DIR=""
    in_conf_dir() {
        [ -n "${REAL_CONF_DIR}" ] || return 1
        (cd -P -- "$1" 2> /dev/null && [ "$(pwd -P)" = "${REAL_CONF_DIR}${1#"${CONF_DIR}"}" ] && shift && "$@")
    }

    # ${CONF_DIR} and data/ are writable by ${GROUP}: --remove-destination replaces a link planted
    # at a destination instead of writing (and chowning, with -a) through it.
    restore_upgrade_preserve() {
        if [ -d "${WAZUH_PRESERVE_DIR}/etc" ]; then
            mkdir -p "${CONF_DIR}"
            cp -a --remove-destination "${WAZUH_PRESERVE_DIR}/etc/." "${CONF_DIR}/"
        fi

        if [ -d "${WAZUH_PRESERVE_DIR}/data" ]; then
            mkdir -p "${DIR}/data"

            for DATA_ENTRY in "${WAZUH_PRESERVE_DIR}/data/"* "${WAZUH_PRESERVE_DIR}/data/."[!.]* "${WAZUH_PRESERVE_DIR}/data/"..?*; do
                [ -e "${DATA_ENTRY}" ] || continue
                cp -a --remove-destination "${DATA_ENTRY}" "${DIR}/data/"
            done
        fi

        if [ -d "${WAZUH_PRESERVE_DIR}" ]; then
            rm -rf "${WAZUH_PRESERVE_DIR}"
        fi
    }

    if [ -d /run/systemd/system ]; then
        rm -f /etc/init.d/wazuh-manager
    fi

    if [ ! -f ${OSMYSHELL} ]; then
        if [ -f "/bin/false" ]; then
            OSMYSHELL="/bin/false"
        fi
    fi

    if ! getent group ${GROUP} > /dev/null 2>&1; then
        groupadd --system ${GROUP} > /dev/null 2>&1
    fi
    if ! getent passwd ${USER} > /dev/null 2>&1; then
        useradd --system --gid ${GROUP} --home-dir ${DIR} --no-create-home --shell ${OSMYSHELL} ${USER} > /dev/null 2>&1
    fi

    if [ -z "$2" ] || [ -f ${WAZUH_TMP_DIR}/create_conf ] ; then

        # Generated and validated in ${WAZUH_TMP_DIR}, then moved into place: a rejected variable
        # leaves no file behind for a retry to treat as pre-existing.
        mkdir -p ${WAZUH_TMP_DIR}
        if ! ${SCRIPTS_DIR}/src/init/gen_wazuh.sh conf manager ${OS} ${VER} ${DIR} > ${WAZUH_TMP_DIR}/wazuh-manager.conf; then
            rm -f ${WAZUH_TMP_DIR}/wazuh-manager.conf
            echo "ERROR: could not generate ${CONF_DIR}/wazuh-manager.conf." >&2
            exit 1
        fi
        # The generated file must validate against the embedded schema (file existence is not
        # checked: the certificates it references are generated later).
        if ! ${DIR}/bin/wazuh-manager-conf --skip-file-checks validate -f ${WAZUH_TMP_DIR}/wazuh-manager.conf; then
            rm -f ${WAZUH_TMP_DIR}/wazuh-manager.conf
            echo "ERROR: the generated ${CONF_DIR}/wazuh-manager.conf is not a valid manager configuration." >&2
            exit 1
        fi
        if ! install_file ${WAZUH_TMP_DIR}/wazuh-manager.conf 660 root:${GROUP} ${CONF_DIR}/wazuh-manager.conf; then
            rm -f ${WAZUH_TMP_DIR}/wazuh-manager.conf
            echo "ERROR: could not install ${CONF_DIR}/wazuh-manager.conf." >&2
            exit 1
        fi
    else
        # A reference file for the administrator, not the active configuration: a rejected
        # variable must not abort the upgrade.
        mkdir -p ${WAZUH_TMP_DIR}
        if ! ${SCRIPTS_DIR}/src/init/gen_wazuh.sh conf manager ${OS} ${VER} ${DIR} > ${WAZUH_TMP_DIR}/wazuh-manager.conf.new \
            || ! install_file ${WAZUH_TMP_DIR}/wazuh-manager.conf.new 660 root:${GROUP} ${CONF_DIR}/wazuh-manager.conf.new; then
            rm -f ${WAZUH_TMP_DIR}/wazuh-manager.conf.new
            echo "WARNING: could not generate ${CONF_DIR}/wazuh-manager.conf.new. The current configuration is unchanged." >&2
        fi
    fi

    # Nothing is cleaned out of var/db/ here: it holds mitre.db and nothing else
    # in 5.x, and preinst refuses an upgrade from an earlier major, so no other
    # file can reach it. Anything left at the old paths is ignored.

    fix_global_db() {
        for DB_FILE in global.db*; do
            if [ -f "${DB_FILE}" ] && [ ! -L "${DB_FILE}" ]; then
                chown -h ${USER}:${GROUP} "${DB_FILE}"
                as_service_user chmod 660 "${DB_FILE}" || true
            fi
        done
    }
    in_dir ${DIR}/queue/db fix_global_db || true

    # Remove Vuln-detector database
    rm -f ${DIR}/queue/vulnerabilities/cve.db || true

    # Certificate directory: root's, readable through ${GROUP}. The daemons read their certificates
    # here after dropping privileges to ${USER}, and nothing writes here at run time. The package
    # ships it; it is only recreated when missing, with its mode set by mkdir itself.
    if [ ! -e ${CONF_DIR}/certs ] && [ ! -L ${CONF_DIR}/certs ]; then
        mkdir -m 0750 ${CONF_DIR}/certs && chown -h root:${GROUP} ${CONF_DIR}/certs
    fi

    # No install-time certificate check any more. The credential resolver invoked below issues the
    # pair when it can, and when it cannot the answer may well have changed by the time the operator
    # starts the service -- so the check belongs at start, where it is made. Warning here about a
    # state that no longer exists is what trains operators to ignore installer output.

    # Every certificate and key is root's and readable through ${GROUP}; re-applied so earlier
    # ownerships get corrected. ${CONF_DIR} is writable by ${GROUP}, so the account could put its
    # own directory (or a link to one) in place of certs/: in_conf_dir() refuses a link, and the
    # owner check refuses a directory that is not root's. Inside a root-owned 0750 directory
    # nobody else can swap an entry, so the chown and chmod below run as root.
    fix_certs() {
        [ "$(stat -c %u .)" = 0 ] || return 1
        chmod 0750 .
        for CERT_FILE in *.pem; do
            if [ -f "${CERT_FILE}" ] && [ ! -L "${CERT_FILE}" ]; then
                chown -h root:${GROUP} "${CERT_FILE}" > /dev/null 2>&1 || true
                chmod 0640 "${CERT_FILE}" > /dev/null 2>&1 || true
            fi
        done
    }

    for BIN in agent_groups agent_upgrade cluster_control rbac_control \
        wazuh-manager-analysisd wazuh-manager-apid wazuh-manager-authd \
        wazuh-manager-clusterd wazuh-manager-control wazuh-manager-service-control wazuh-manager-db \
        wazuh-manager-keystore wazuh-manager-modulesd wazuh-manager-remoted \
        wazuh-manager-resolve-credentials; do
        if [ -f "${DIR}/bin/${BIN}" ]; then
            case "${BIN}" in
                wazuh-manager-service-control)
                    chown root:${GROUP} "${DIR}/bin/${BIN}"
                    chmod 4750 "${DIR}/bin/${BIN}"
                    ;;
                agent_groups|agent_upgrade|cluster_control|rbac_control|wazuh-manager-apid|wazuh-manager-clusterd|wazuh-manager-resolve-credentials)
                    chown root:${GROUP} "${DIR}/bin/${BIN}"
                    ;;
                *)
                    chown root:root "${DIR}/bin/${BIN}"
                    ;;
            esac
        fi
    done

    if [ -f "${DIR}/bin/verify-agent-conf" ]; then
        chown root:${GROUP} "${DIR}/bin/verify-agent-conf"
    fi

    # Restore RBAC database (preinst kept owner and mode)
    if [ -f ${WAZUH_TMP_DIR}/rbac.db ]; then
        in_dir ${DIR}/api/configuration/security mv -fT ${WAZUH_TMP_DIR}/rbac.db rbac.db || true
    fi

    # Restore API configuration file
    if [ -f ${WAZUH_TMP_DIR}/api.yaml ]; then
        mv -fT ${WAZUH_TMP_DIR}/api.yaml ${DIR}/api/configuration/api.yaml
    fi

    # More files
    if [ ! -e ${CONF_DIR}/client.keys ] && [ ! -L ${CONF_DIR}/client.keys ]; then
        mkdir -p ${WAZUH_TMP_DIR}
        : > ${WAZUH_TMP_DIR}/client.keys && \
            install_file ${WAZUH_TMP_DIR}/client.keys 660 ${USER}:${GROUP} ${CONF_DIR}/client.keys
    fi

    # A link in logs/ is never a log file. A missing log is created empty in ${WAZUH_TMP_DIR} and
    # renamed into place: on a fresh install logs/ is not writable by ${USER} yet (dh_fixperms
    # leaves it root-owned without group write until restore-permissions.sh runs below). An
    # existing one gets chown -h and a chmod run as ${USER}. Anything else at that name (a
    # directory, for instance) is reported and left alone.
    for LOG_FILE in wazuh-manager.log wazuh-manager.json; do
        if [ -L "${DIR}/logs/${LOG_FILE}" ]; then
            rm -f "${DIR}/logs/${LOG_FILE}"
        fi
        if [ ! -e "${DIR}/logs/${LOG_FILE}" ] && [ ! -L "${DIR}/logs/${LOG_FILE}" ]; then
            mkdir -p ${WAZUH_TMP_DIR}
            { : > ${WAZUH_TMP_DIR}/${LOG_FILE} && \
                install_file ${WAZUH_TMP_DIR}/${LOG_FILE} 660 ${USER}:${GROUP} ${DIR}/logs/${LOG_FILE}; } || \
                echo "Error: could not create ${DIR}/logs/${LOG_FILE}." >&2
        elif [ -f "${DIR}/logs/${LOG_FILE}" ] && [ ! -L "${DIR}/logs/${LOG_FILE}" ]; then
            chown -h ${USER}:${GROUP} ${DIR}/logs/${LOG_FILE}
            as_service_user chmod 0660 ${DIR}/logs/${LOG_FILE} || true
        else
            echo "Error: ${DIR}/logs/${LOG_FILE} is not a regular file; leaving it untouched." >&2
        fi
    done

    # Restore the preserved configuration and data/ as the last content-restore/overwrite
    # step for those trees, matching the RPM %posttrans ordering and the
    # strict "the configuration MUST NOT be overwritten" contract from the upgrade rules.
    restore_upgrade_preserve


    # Restoring file permissions, of the installation directory and of the configuration directory
    ${SCRIPTS_DIR}/restore-permissions.sh > /dev/null 2>&1 || true
    ${SCRIPTS_DIR}/restore-permissions-conf.sh > /dev/null 2>&1 || true

    # merged.mg is generated by remoted; it is read by agents through it, never written by them.
    fix_merged_mg() {
        for MERGED_FILE in merged.mg */merged.mg; do
            if [ -f "${MERGED_FILE}" ] && [ ! -L "${MERGED_FILE}" ]; then
                chown -h ${USER}:${GROUP} "${MERGED_FILE}" > /dev/null 2>&1 || true
                as_service_user chmod 644 "${MERGED_FILE}" > /dev/null 2>&1 || true
            fi
        done
    }
    in_conf_dir ${CONF_DIR}/shared fix_merged_mg || true

    # After the restore above, which keeps the preserved ownership (cp -a).
    in_conf_dir ${CONF_DIR}/certs fix_certs || true

    # The engine (wazuh-manager-analysisd) now drops privileges to wazuh-manager:
    # runtime data created by root in previous versions must be reassigned.
    # restore-permissions.sh only covers paths present in the package tree.
    chown -R ${USER}:${GROUP} ${DIR}/data/ruleset > /dev/null 2>&1 || true
    chown -R ${USER}:${GROUP} ${DIR}/data/kvdb-ioc > /dev/null 2>&1 || true
    for YEAR_DIR in ${DIR}/logs/[0-9][0-9][0-9][0-9]; do
        if [ -d "${YEAR_DIR}" ]; then
            chown -R ${USER}:${GROUP} "${YEAR_DIR}" > /dev/null 2>&1 || true
        fi
    done

    # Resolve every credential the manager owns or consumes: seed rbac.db with generated or
    # supplied Server API passwords, store the indexer password in the keystore, import the
    # indexer's CA and client pair from /etc/wazuh-indexer/export when it is installed here, and --
    # on a fresh install only -- mint the manager's CA and issue its two server pairs. Runs last,
    # once the tree, its permissions and the configuration are all in place.
    #
    # `configure` fires on a fresh install and on an upgrade alike; $2 is the version we are
    # upgrading from, and empty on a fresh install. That distinction is the whole reason the two
    # modes exist: --upgrade completes the passwords, the keystore and the indexer trust (each a
    # no-op once in place) and only validates the manager's CA and server pairs: it never mints a
    # CA or issues a pair. An operator who replaced them with their own PKI must not find them
    # reissued by a package upgrade.
    #
    # Neither mode may abort this script. A maintainer script that exits non-zero leaves the
    # package half-configured, breaks `apt install -f` and fails image builds, so both always exit
    # 0 and simply leave unresolved whatever they could not resolve. The service refuses to start
    # and names what is missing; that is where the check belongs, because the answer changes
    # between these two moments and only the answer at start matters.
    if [ -x ${DIR}/bin/wazuh-manager-resolve-credentials ]; then
        # A reinstall from the config-files state also passes the old version, but postrm renamed
        # every file in ${CONF_DIR} to *.save: with no server pair in place there is nothing to
        # keep, so it resolves as an install and issues the certificates. The indexer's files are
        # no sign either way: they are absent wherever the indexer runs on another host.
        if [ -z "$2" ] || [ ! -e ${CONF_DIR}/certs/remoted.pem ]; then
            CRED_MODE="--install"
        else
            CRED_MODE="--upgrade"
        fi
        ${DIR}/bin/wazuh-manager-resolve-credentials ${CRED_MODE} -H ${DIR} || true
    fi

    # Remove old service file /etc/systemd/system/wazuh-manager.service if present
    if [ -f /etc/systemd/system/wazuh-manager.service ]; then
        rm -f /etc/systemd/system/wazuh-manager.service
        if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
            systemctl daemon-reload > /dev/null 2>&1
        fi
    fi

    if [ ! -z "$2" ]; then
        # Load the unit this package ships whatever the service state: a stopped one would
        # otherwise start next with the previous unit definition.
        if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
            systemctl daemon-reload > /dev/null 2>&1
        fi
        if [ -f ${WAZUH_TMP_DIR}/wazuh.restart ] ; then
            if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
                systemctl restart wazuh-manager.service > /dev/null 2>&1
            elif command -v service > /dev/null 2>&1 ; then
                service wazuh-manager restart > /dev/null 2>&1
            else
                ${DIR}/bin/wazuh-manager-control restart > /dev/null 2>&1
            fi
        fi
    fi

    # Delete deprecated manage_agents binary
    if [ -f ${DIR}/bin/manage_agents ]; then
        rm -f ${DIR}/bin/manage_agents
    fi

    # Delete installation scripts
    if [ -d ${SCRIPTS_DIR} ]; then
        rm -rf ${SCRIPTS_DIR}
    fi

    # Delete tmp directory
    if [ -d ${WAZUH_TMP_DIR} ]; then
        rm -r ${WAZUH_TMP_DIR}
    fi

    # If the parent directory is empty, delete it
    if [ -z "$(ls -A ${WAZUH_GLOBAL_TMP_DIR})" ]; then
        rm -rf ${WAZUH_GLOBAL_TMP_DIR}
    fi

    # Next steps, last thing a fresh install prints (the indexer and the dashboard end the same way):
    # the package neither starts nor enables the service, and nothing else says where the Server API
    # passwords went. Only on a fresh install ($2 empty): an upgrade restarts a running manager by
    # itself, and a reinstall -- also from the config-files state -- finds the passwords already set.
    # install.sh prints its own start hint, so this lives in the package only.
    if [ -z "$2" ]; then
        echo "Server API passwords saved in ${CONF_DIR}/export/credentials.env (readable by root only)."
        if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
            echo "Start the manager and enable it at boot: systemctl enable --now wazuh-manager"
        else
            echo "Start the manager: service wazuh-manager start"
        fi
    fi

    ;;


    abort-upgrade|abort-remove|abort-deconfigure)

    ;;


    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;

esac

exit 0
