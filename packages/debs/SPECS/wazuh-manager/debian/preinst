#!/bin/sh
# preinst script for Wazuh
set -e

# configuration variables
DIR="/var/wazuh-manager"
# The configuration directory is fixed, outside the installation directory.
CONF_DIR="/etc/wazuh-manager"
WAZUH_TMP_DIR="${DIR}/packages_files/manager_config_files"
WAZUH_PRESERVE_DIR="${DIR}/packages_files/manager_upgrade_preserve"
prepare_tmp_dir() {
    if [ -d "${WAZUH_TMP_DIR}" ]; then
        rm -rf "${WAZUH_TMP_DIR}"
    fi
    mkdir -p "${WAZUH_TMP_DIR}"
}

# Refuses, and takes the directory, while the manager is still running: postrm
# failed-upgrade|abort-upgrade keeps this directory on purpose, so once an upgrade has failed every
# later attempt finds it, and refusing after the stop would take the manager down and leave it
# down, since the wazuh.restart marker is only honoured by a postinst that never runs after a
# failed preinst. A plain mkdir, so the snapshot always copies into a directory this run made.
reserve_upgrade_preserve() {
    if [ -e "${WAZUH_PRESERVE_DIR}" ]; then
        echo "ERROR: Existing manager upgrade preserve backup found at ${WAZUH_PRESERVE_DIR}." >&2
        echo "ERROR: Recover or move this directory before retrying the upgrade." >&2
        exit 1
    fi
    mkdir -p "${DIR}/packages_files"
    mkdir -m 0700 "${WAZUH_PRESERVE_DIR}"
}

# Into the directory reserve_upgrade_preserve() made.
backup_upgrade_preserve() {
    if [ -d "${CONF_DIR}" ]; then
        mkdir -p "${WAZUH_PRESERVE_DIR}/etc"
        cp -a "${CONF_DIR}/." "${WAZUH_PRESERVE_DIR}/etc/"
    fi

    if [ -d "${DIR}/data" ]; then
        mkdir -p "${WAZUH_PRESERVE_DIR}/data"
        for DATA_ENTRY in "${DIR}/data/"* "${DIR}/data/."[!.]* "${DIR}/data/"..?*; do
            [ -e "${DATA_ENTRY}" ] || continue
            [ "${DATA_ENTRY##*/}" = "tzdb" ] && continue
            cp -a "${DATA_ENTRY}" "${WAZUH_PRESERVE_DIR}/data/"
        done
    fi
}

# print_unsupported_manager_upgrade VERSION [host]: the refusal of a manager older than 5.0, as the
# package being upgraded or, with "host", anywhere on this host (a fresh install is refused beside it).
print_unsupported_manager_upgrade() {
    DETECTED_VERSION="${1:-unknown}"
    if [ "${2:-}" = "host" ]; then
        UNSUPPORTED_REASON="A Wazuh manager older than 5.0 is installed on this host: Wazuh manager 5.x can neither upgrade it nor be installed beside it."
    else
        UNSUPPORTED_REASON="Upgrade from Wazuh manager versions prior to 5.x is not supported."
    fi
    cat <<EOF >&2
==============================================================
ERROR: ${UNSUPPORTED_REASON}

Detected installed version: ${DETECTED_VERSION#v}

A clean installation of Wazuh manager 5.x is required.
Refer to the 5.x migration guide for more information.
==============================================================
EOF
}

# major_of VERSION: the major number of a version such as v4.14.0 or 4.14.0-1.
major_of() {
    MAJOR_OF="${1#v}"
    echo "${MAJOR_OF%%.*}"
}

# json_version FILE: the value of "version" in a VERSION.json.
json_version() {
    while IFS= read -r JSON_LINE || [ -n "${JSON_LINE}" ]; do
        case "${JSON_LINE}" in
            *'"version"'*)
                JSON_LINE="${JSON_LINE#*\"version\"}"
                JSON_LINE="${JSON_LINE#*\"}"
                echo "${JSON_LINE%%\"*}"
                return 0
                ;;
        esac
    done < "$1"
    return 1
}

# is_pre5 VERSION: true when VERSION names a major before 5.
is_pre5() {
    PRE5_MAJOR=$(major_of "$1")
    case "${PRE5_MAJOR}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "${PRE5_MAJOR}" -le 4 ]
}

# A 4.x manager on this host, whether or not this is a package upgrade: its init file (TYPE server or
# local), or the version file of a /var/ossec install that reports itself as a server.
installed_pre5_version() {
    # Only a 4.x manager (TYPE server or local) blocks this one: a 4.x agent beside it is allowed.
    if [ -f /etc/ossec-init.conf ]; then
        OSSEC_INIT_TYPE=$(set +e; . /etc/ossec-init.conf > /dev/null 2>&1; echo "${TYPE}") || OSSEC_INIT_TYPE=""
        OSSEC_INIT_VERSION=$(set +e; . /etc/ossec-init.conf > /dev/null 2>&1; echo "${VERSION}") || OSSEC_INIT_VERSION=""
        case "${OSSEC_INIT_TYPE}" in
            server|local) ;;
            *) OSSEC_INIT_VERSION="" ;;
        esac
        if is_pre5 "${OSSEC_INIT_VERSION}"; then
            echo "${OSSEC_INIT_VERSION}"
            return 0
        fi
    fi
    if [ -f /var/ossec/VERSION.json ] && [ -x /var/ossec/bin/wazuh-control ] \
        && [ "$(/var/ossec/bin/wazuh-control info -t 2>/dev/null)" = "server" ]; then
        OSSEC_JSON_VERSION=$(json_version /var/ossec/VERSION.json 2>/dev/null) || OSSEC_JSON_VERSION=""
        if is_pre5 "${OSSEC_JSON_VERSION}"; then
            echo "${OSSEC_JSON_VERSION}"
            return 0
        fi
    fi
    return 1
}

# The pids of every running wazuh-manager-authd, from /proc (no procps).
authd_pids() {
    for PROC_DIR in /proc/[0-9]*; do
        [ -r "${PROC_DIR}/cmdline" ] || continue
        IFS= read -r PROC_CMD < "${PROC_DIR}/cmdline" 2>/dev/null || [ -n "${PROC_CMD}" ] || continue
        case "${PROC_CMD}" in
            *wazuh-manager-authd*) echo "${PROC_DIR#/proc/}" ;;
        esac
        PROC_CMD=""
    done
}

# running TEXT: true when a status text says the service is running.
running() {
    case "$1" in
        *"is running"*) return 0 ;;
    esac
    return 1
}

# Undoes a run that failed between the reservation and the end of the snapshot (an EXIT trap, so
# a command that fails under set -e is covered too): the directory this run reserved goes (its
# content, if any, is a partial copy of files still in place), and the manager is started again,
# through the same tool that found it running, when the stop had been reached. The marker goes
# too: postinst configure will not run after this preinst fails.
undo_failed_upgrade_preserve() {
    # The handler inherits set -e; nothing here may end it before the restart is attempted.
    set +e
    rm -rf "${WAZUH_PRESERVE_DIR}" \
        || echo "WARNING: could not remove ${WAZUH_PRESERVE_DIR}; remove it by hand before retrying the upgrade." >&2
    if [ -f "${WAZUH_TMP_DIR}/wazuh.restart" ]; then
        rm -f "${WAZUH_TMP_DIR}/wazuh.restart"
        case "${RESTART_WITH:-}" in
            systemctl) systemctl start wazuh-manager.service > /dev/null 2>&1 ;;
            service) service wazuh-manager start > /dev/null 2>&1 ;;
            *) ${DIR}/bin/wazuh-manager-control start > /dev/null 2>&1 ;;
        esac || echo "WARNING: the manager could not be started again after the failed upgrade; start it by hand." >&2
    fi
}

case "$1" in
    install|upgrade)

        # $2 contains the old version in upgrade scenarios. Checked before the host so that an
        # upgrade of the 4.x package prints the header every 5.x central component prints.
        if [ "$1" = "upgrade" ] && [ -n "$2" ] && is_pre5 "$2"; then
            print_unsupported_manager_upgrade "$2"
            exit 1
        fi

        # HARD BLOCK: no 4.x manager may sit beside this one, on an upgrade or on a fresh install.
        if PRE5_VERSION=$(installed_pre5_version); then
            print_unsupported_manager_upgrade "${PRE5_VERSION}" host
            exit 1
        fi

        if [ "$1" = "upgrade" ]; then
            # Get version information
            OLD_VERSION=""
            if [ -f "${DIR}/bin/wazuh-manager-control" ]; then
                OLD_VERSION=$(${DIR}/bin/wazuh-manager-control info -v 2>/dev/null) || OLD_VERSION=""
            elif [ -f ${DIR}/VERSION.json ]; then
                OLD_VERSION=$(json_version ${DIR}/VERSION.json 2>/dev/null) || OLD_VERSION=""
            fi
            MAJOR_VER=$(major_of "${OLD_VERSION}")

            # Determine if upgrade should be blocked
            case "${MAJOR_VER}" in
                ''|*[!0-9]*)
                    print_unsupported_manager_upgrade "${OLD_VERSION}"
                    exit 1
                    ;;
            esac
            if [ "${MAJOR_VER}" -lt 5 ]; then
                print_unsupported_manager_upgrade "${OLD_VERSION}"
                exit 1
            fi

            # Before anything is written or stopped. From here until the snapshot is complete, any
            # failure undoes the reservation (and the stop, once reached).
            reserve_upgrade_preserve
            trap undo_failed_upgrade_preserve EXIT

            # environment configuration (original behavior, after hard-block checks)
            prepare_tmp_dir
            touch "${WAZUH_TMP_DIR}/rollback_prepared"

            RESTART_WITH=""
            if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1 && systemctl is-active --quiet wazuh-manager > /dev/null 2>&1; then
                systemctl stop wazuh-manager.service > /dev/null 2>&1
                touch ${WAZUH_TMP_DIR}/wazuh.restart
                RESTART_WITH="systemctl"
            elif command -v service > /dev/null 2>&1 && running "$(service wazuh-manager status 2>/dev/null)"; then
                service wazuh-manager stop > /dev/null 2>&1
                touch ${WAZUH_TMP_DIR}/wazuh.restart
                RESTART_WITH="service"
            elif running "$(${DIR}/bin/wazuh-manager-control status 2>/dev/null)"; then
                touch ${WAZUH_TMP_DIR}/wazuh.restart
                RESTART_WITH="control"
            fi
            if [ -x "${DIR}/bin/wazuh-manager-control" ]; then
                ${DIR}/bin/wazuh-manager-control stop > /dev/null 2>&1
            fi
            AUTHD_PIDS=$(authd_pids)
            if [ -n "${AUTHD_PIDS}" ]; then
                kill -15 ${AUTHD_PIDS} > /dev/null 2>&1 || true
            fi

            # A subshell on its own, with -e re-enabled inside: the shell ignores set -e within a
            # command whose status is tested, so an if or || around the function would let a failed
            # cp go on and report whatever the last command returned. The outer -e is suspended
            # only around it, so the failure is reported before the trap undoes it.
            set +e
            ( set -e; backup_upgrade_preserve )
            SNAPSHOT_STATUS=$?
            set -e
            if [ "${SNAPSHOT_STATUS}" -ne 0 ]; then
                echo "ERROR: Could not prepare manager upgrade preserve backup at ${WAZUH_PRESERVE_DIR}." >&2
                exit 1
            fi
            trap - EXIT

            # api/configuration/ is writable by ${GROUP}: a link there is not ours to back up, and
            # cp would carry its target's content into the restored file.
            # RBAC database
            if [ -f ${DIR}/api/configuration/security/rbac.db ] && [ ! -L ${DIR}/api/configuration/security/rbac.db ]; then
                cp -fpP ${DIR}/api/configuration/security/rbac.db ${WAZUH_TMP_DIR}/rbac.db
            fi

            # API configuration file
            if [ -f ${DIR}/api/configuration/api.yaml ] && [ ! -L ${DIR}/api/configuration/api.yaml ]; then
                cp -fpP ${DIR}/api/configuration/api.yaml ${WAZUH_TMP_DIR}/api.yaml
            fi

        else
            # environment configuration (original behavior for install)
            prepare_tmp_dir
        fi

        if [ ! -z "$2" ] && [ ! -f ${CONF_DIR}/wazuh-manager.conf ] ; then
            touch ${WAZUH_TMP_DIR}/create_conf
        fi

        # Remove plain-text agent information if exists
        if [ -d ${DIR}/queue/agent-info ]; then
            rm -rf ${DIR}/queue/agent-info/* > /dev/null 2>&1
        fi
    ;;

    abort-upgrade)

    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 0

    ;;

esac

exit 0
