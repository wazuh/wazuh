#!/bin/sh
# postrm script for Wazuh
# Wazuh, Inc 2015
set -e
DPKG_LIST_FILE="/var/lib/dpkg/info/wazuh-manager.list"

DIR="/var/wazuh-manager"
if [ "$1" = "abort-upgrade" ] || [ "$1" = "failed-upgrade" ]; then
    DIR=$(grep -m 1 -E '/bin/(wazuh-manager-control|wazuh-control)$' "${DPKG_LIST_FILE}" 2>/dev/null \
        | sed -E 's#/bin/(wazuh-manager-control|wazuh-control)$##')

    if [ -z "${DIR}" ] || [ ! -d "${DIR}" ]; then
        exit 0
    fi
fi

WAZUH_TMP_DIR="${DIR}/packages_files/manager_config_files"
WAZUH_PRESERVE_DIR="${DIR}/packages_files/manager_upgrade_preserve"
ROLLBACK_MARKER="${WAZUH_TMP_DIR}/rollback_prepared"

# If preinst did not prepare rollback state, abort safely.
if [ "$1" = "abort-upgrade" ] || [ "$1" = "failed-upgrade" ]; then
    if [ ! -f "${ROLLBACK_MARKER}" ]; then
        exit 0
    fi
fi

case "$1" in
    remove|failed-upgrade|abort-install|abort-upgrade|disappear)

        case "$1" in
            failed-upgrade|abort-upgrade)
                if [ -d "${WAZUH_TMP_DIR}" ]; then
                    echo "Wazuh upgrade recovery files were preserved at ${WAZUH_TMP_DIR}. Restore them manually if needed." >&2
                fi
                if [ -d "${WAZUH_PRESERVE_DIR}" ]; then
                    echo "Wazuh upgrade recovery files were preserved at ${WAZUH_PRESERVE_DIR}. Restore them manually if needed." >&2
                fi
                ;;
            *)
                if [ -d ${WAZUH_TMP_DIR} ]; then
                    rm -rf ${WAZUH_TMP_DIR}
                fi
                if [ -d "${WAZUH_PRESERVE_DIR}" ]; then
                    rm -rf "${WAZUH_PRESERVE_DIR}"
                fi
                ;;
        esac

        # Back up the old configuration files as .save
        if [ ! -d ${DIR}/etc/shared/default ]; then
            mkdir -p ${DIR}/etc/shared/default
        fi

        # Move files from ${DIR}/tmp to ${DIR}/etc
        if [ -f ${DIR}/tmp/conffiles/shared/default/agent.conf ]; then
            mv ${DIR}/tmp/conffiles/shared/default/agent.conf ${DIR}/etc/shared/default/agent.conf.save
        fi

        # Move files from ${DIR}/tmp to ${DIR}/etc
        if [ -f ${DIR}/tmp/conffiles/api.yaml ]; then
            mkdir -p ${DIR}/api/configuration
            mv ${DIR}/tmp/conffiles/api.yaml ${DIR}/api/configuration/api.yaml
        fi

        # If the directory is not empty, copy the files into ${DIR}/etc
        if ls -A ${DIR}/tmp/conffiles > /dev/null 2>&1 ; then
            cp -Rf ${DIR}/tmp/conffiles/* ${DIR}/etc
        fi
        rm -rf ${DIR}/tmp
        if [ "$1" = "remove" ]; then
            rm -rf ${DIR}/ruleset
            rm -rf ${DIR}/var
            rm -rf ${DIR}/logs
            rm -rf ${DIR}/data
        fi

        # Delete old .save
        find ${DIR}/etc/ -type f  -name "*save" -exec rm -f {} \;

        # Rename the files
        find ${DIR}/etc/ -type f ! -name *shared* -exec mv {} {}.save \;

        if [ -d "${DIR}/api" ]; then
            find "${DIR}/api/" -type f -name "*save" -exec rm -f {} \;
            find "${DIR}/api/" -type f -exec mv {} {}.save \;
        fi

    ;;

    purge)
        # Take the manager's own keys out of the shared credentials file. This deliberately does NOT
        # source lib/wazuh-credentials.sh: by the time purge runs, dpkg has already removed the
        # package's files, so that helper is gone. It therefore repeats wazuh_env_unset's effect and
        # must keep the helper's paths, block markers and lock byte for byte -- note the em dash and
        # the trailing "<<<" in the markers, and .credentials.lock rather than .credentials.env.lock.
        #
        # Only the manager's own keys, and only inside the managed block: the other components' keys
        # and anything the operator wrote are not ours to remove, even when they carry the same name.
        #
        # The key list is spelled out rather than swept by a WAZUH_MANAGER_ prefix so that it is the
        # SAME list the RPM's %preun feeds to wazuh_env_unset(). The two removal paths must take
        # exactly the same keys out of the file; an open-ended prefix here would also claim a key a
        # future sibling publishes under that name.
        CRED_KEYS="WAZUH_MANAGER_API_PASSWORD WAZUH_MANAGER_WUI_PASSWORD WAZUH_MANAGER_CERT_SANS WAZUH_MANAGER_REMOTED_CERT_SANS"

        # WAZUH_BASE_DIR is how wazuh_base_get_dir() resolves the base, and it is a process setting
        # only -- reading it from the file whose location it decides would be circular. Honouring it
        # here is what keeps this path and the RPM's (which can still call the helper) pointed at the
        # same directory on a relocated install.
        CRED_DIR="${WAZUH_BASE_DIR:-/etc/wazuh}"
        CRED_FILE="${CRED_DIR}/credentials.env"
        CRED_LOCK="${CRED_DIR}/.credentials.lock"
        if [ -f "${CRED_FILE}" ] && [ ! -L "${CRED_FILE}" ]; then
            # Set here and not inside the subshell: `9>` is applied when the subshell is created, so
            # a umask set in its body comes too late and would leave a newly created lock at 0644 --
            # which _wazuh_validate_regular_file() then refuses at the next install.
            CRED_UMASK=$(umask)
            umask 077
            (
                flock -w 30 9 || exit 0
                awk -v begin="# >>> wazuh generated — do not edit <<<" -v end="# >>> end wazuh generated <<<" \
                    -v keys="${CRED_KEYS}" '
                    BEGIN { n = split(keys, k, " "); for (i = 1; i <= n; i++) drop[k[i]] = 1 }
                    $0 == begin { inblock = 1; print; next }
                    $0 == end   { inblock = 0; print; next }
                    inblock {
                        equal = index($0, "=")
                        if (equal && (substr($0, 1, equal - 1) in drop)) next
                    }
                    { print }
                ' "${CRED_FILE}" > "${CRED_FILE}.tmp" \
                    && chown root:root "${CRED_FILE}.tmp" && chmod 0600 "${CRED_FILE}.tmp" \
                    && mv -f "${CRED_FILE}.tmp" "${CRED_FILE}" \
                    || rm -f "${CRED_FILE}.tmp"
            ) 9>"${CRED_LOCK}" || true
            umask "${CRED_UMASK}"
        fi

        # The last component out removes what is left, /etc/wazuh included -- whether or not the
        # credentials file is still there, since the documentation tells operators to delete it once
        # every component runs, and the CA private key must not outlive the last component.
        #
        # "Last" is asked of dpkg, not inferred from the file's contents. A leftover WAZUH_ key
        # says nothing about whether a sibling is installed -- an operator who wrote one line by
        # hand on a manager-only host would otherwise keep the credentials file and the CA
        # private key on a machine with no Wazuh left on it.
        #
        # Only the CA directory under the base is removed. One relocated through WAZUH_CA_DIR is
        # left alone: without the helper we cannot resolve it, and deleting a path we cannot confirm
        # is worse than leaving one behind. The base goes with rmdir rather than rm -rf, so anything
        # an operator put there that we do not recognise survives. Identical to the RPM's %preun.
        #
        # `set -e` is active, so every branch is an explicit if with || true: a bare
        # `[ ... ] && cmd` whose test fails would abort the purge.
        # ${db:Status-Status} is the status word alone. `${Status}` is "<want> <eflag> <status>",
        # so matching 'install ok installed' misses a sibling the operator put on hold, which
        # reports 'hold ok installed' -- and purging the manager beside a held wazuh-indexer would
        # then take credentials.env and the CA private key out from under it.
        CRED_SIBLING_LEFT=no
        for CRED_SIBLING in wazuh-indexer wazuh-dashboard; do
            if [ "$(dpkg-query -W -f='${db:Status-Status}' "${CRED_SIBLING}" 2>/dev/null)" = installed ]; then
                CRED_SIBLING_LEFT=yes
            fi
        done

        if [ "${CRED_SIBLING_LEFT}" = no ]; then
            rm -f "${CRED_FILE}" "${CRED_LOCK}" > /dev/null 2>&1 || true
            rm -rf "${CRED_DIR}/ca" > /dev/null 2>&1 || true
            rmdir "${CRED_DIR}" > /dev/null 2>&1 || true
        fi

        if getent passwd wazuh-manager > /dev/null 2>&1 ; then
            deluser wazuh-manager  > /dev/null 2>&1
        fi
        if getent group wazuh-manager > /dev/null 2>&1; then
            delgroup wazuh-manager  > /dev/null 2>&1
        fi
        rm -rf ${DIR}
    ;;

    upgrade)

    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 0

    ;;

esac

exit 0
