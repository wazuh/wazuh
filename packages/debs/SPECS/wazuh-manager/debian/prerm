#!/bin/sh
# prerm script for wazuh-manager

set -e
DIR="/var/wazuh-manager"
# The configuration directory is fixed, outside the installation directory.
CONF_DIR="/etc/wazuh-manager"

case "$1" in
    upgrade|deconfigure)

    ;;

    remove)
      # Stop the services before uninstalling the package
      # Check for systemd
      if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1 && systemctl is-active --quiet wazuh-manager > /dev/null 2>&1; then
          systemctl stop wazuh-manager > /dev/null 2>&1
      # Check for SysV
      elif command -v service > /dev/null 2>&1; then
          case "$(service wazuh-manager status 2>/dev/null)" in
              *running*) service wazuh-manager stop > /dev/null 2>&1 ;;
          esac
      fi
      ${DIR}/bin/wazuh-manager-control stop > /dev/null 2>&1

      # Purging files
      rm -rf ${DIR}/stats/*
      rm -rf ${DIR}/queue/*
      rm -rf ${DIR}/var/*
      rm -rf ${DIR}/framework/*

      # Save the configuration files in ${DIR}/tmp/conffiles. tmp/ is writable by wazuh-manager,
      # which could leave a link there for mkdir -p and cp to follow: whatever is there goes, and a
      # plain mkdir makes the directory anew, failing if anything took its place meanwhile. Root
      # owns it, and the sticky bit on tmp/ keeps the service account from replacing it until
      # postrm. A link among the files to save is not ours: skipped, and -P keeps one swapped in
      # meanwhile a link.
      rm -rf ${DIR}/tmp/conffiles
      if mkdir -m 0750 ${DIR}/tmp/conffiles 2> /dev/null; then
        for CONF_FILE in client.keys wazuh-manager-internal-options.conf wazuh-manager.conf; do
          if [ -f ${CONF_DIR}/${CONF_FILE} ] && [ ! -L ${CONF_DIR}/${CONF_FILE} ]; then
            cp -pP ${CONF_DIR}/${CONF_FILE} ${DIR}/tmp/conffiles
          fi
        done

        # Save the agent.conf from the group default
        mkdir -p ${DIR}/tmp/conffiles/shared/default
        if [ -f ${CONF_DIR}/shared/default/agent.conf ] && [ ! -L ${CONF_DIR}/shared/default/agent.conf ]; then
          cp -pP ${CONF_DIR}/shared/default/agent.conf ${DIR}/tmp/conffiles/shared/default
        fi
        # Save the api.yaml
        if [ -f ${DIR}/api/configuration/api.yaml ] && [ ! -L ${DIR}/api/configuration/api.yaml ]; then
          cp -pP ${DIR}/api/configuration/api.yaml ${DIR}/tmp/conffiles
        fi
      else
        echo "WARNING: could not create ${DIR}/tmp/conffiles; the configuration files will not be kept as .save." >&2
      fi
      if [ -f ${DIR}/api/configuration/api.yaml ]; then
        rm -rf ${DIR}/api/*
      fi
    ;;

    failed-upgrade)
      if [ -f ${DIR}/bin/wazuh-manager-control ]; then
	       ${DIR}/bin/wazuh-manager-control stop > /dev/null 2>&1
      fi
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 0
    ;;

esac

exit 0
