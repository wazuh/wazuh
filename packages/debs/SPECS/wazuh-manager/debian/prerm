#!/bin/sh
# prerm script for wazuh-manager

set -e
DIR="/var/wazuh-manager"
# The configuration directory is fixed, outside the installation directory.
CONF_DIR="/etc/wazuh-manager"

case "$1" in
    upgrade|deconfigure)

    ;;

    remove)
      # Stop the services before uninstalling the package
      # Check for systemd
      if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1 && systemctl is-active --quiet wazuh-manager > /dev/null 2>&1; then
          systemctl stop wazuh-manager > /dev/null 2>&1
      # Check for SysV
      elif command -v service > /dev/null 2>&1; then
          case "$(service wazuh-manager status 2>/dev/null)" in
              *running*) service wazuh-manager stop > /dev/null 2>&1 ;;
          esac
      fi
      ${DIR}/bin/wazuh-manager-control stop > /dev/null 2>&1

      # Purging files
      rm -rf ${DIR}/stats/*
      rm -rf ${DIR}/queue/*
      rm -rf ${DIR}/var/*
      rm -rf ${DIR}/framework/*

      # Save the configuration files in ${DIR}/tmp/conffiles
      mkdir -p ${DIR}/tmp/conffiles

      # Save the client.keys
      if [ -f ${CONF_DIR}/client.keys ]; then
        cp -p ${CONF_DIR}/client.keys ${DIR}/tmp/conffiles
      fi
      # Save the wazuh-manager-internal-options.conf
      if [ -f ${CONF_DIR}/wazuh-manager-internal-options.conf ]; then
        cp -p ${CONF_DIR}/wazuh-manager-internal-options.conf ${DIR}/tmp/conffiles
      fi
      # Save the wazuh-manager.conf
      if [ -f ${CONF_DIR}/wazuh-manager.conf ]; then
        cp -p ${CONF_DIR}/wazuh-manager.conf ${DIR}/tmp/conffiles
      fi

      # Save the agent.conf from the group default
      mkdir -p ${DIR}/tmp/conffiles/shared/default
      if [ -f ${CONF_DIR}/shared/default/agent.conf ]; then
        cp -p ${CONF_DIR}/shared/default/agent.conf ${DIR}/tmp/conffiles/shared/default
      fi
      # Save the api.yaml
      if [ -f ${DIR}/api/configuration/api.yaml ]; then
        cp -p ${DIR}/api/configuration/api.yaml ${DIR}/tmp/conffiles
        rm -rf ${DIR}/api/*
      fi
    ;;

    failed-upgrade)
      if [ -f ${DIR}/bin/wazuh-manager-control ]; then
	       ${DIR}/bin/wazuh-manager-control stop > /dev/null 2>&1
      fi
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 0
    ;;

esac

exit 0
