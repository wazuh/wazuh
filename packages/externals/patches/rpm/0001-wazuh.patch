-			--format=${distfmt}
-			--output=${CMAKE_BINARY_DIR}/${tarname}
-			--prefix=${namever}/
-			--add-file=${CMAKE_BINARY_DIR}/ChangeLog
-			${treeish}
-		COMMAND git submodule foreach --quiet
-			"git archive --prefix=${namever}/$sm_path/ \
-				--output=${CMAKE_BINARY_DIR}/$sha1.tar HEAD \
