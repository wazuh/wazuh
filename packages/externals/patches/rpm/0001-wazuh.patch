-		COMMAND tar --concatenate
-				--file=${CMAKE_BINARY_DIR}/${tarname}
-				${CMAKE_BINARY_DIR}/${docname}
-		COMMAND bzip2 -f ${CMAKE_BINARY_DIR}/${tarname}
-	)
