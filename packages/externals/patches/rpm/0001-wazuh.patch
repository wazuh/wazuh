-function(chkdef func req)
-	string(TOUPPER ${func} FUNC)
-	set(HAVENAME HAVE_${FUNC})
-	check_function_exists(${func} ${HAVENAME})
-	if (${req} AND NOT ${HAVENAME})
-		message(FATAL_ERROR "required function ${func} not found")
-	endif()
-endfunction()
