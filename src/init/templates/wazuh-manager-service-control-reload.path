[Unit]
Description=Wazuh manager reload requests
# Watches whenever the host is up, whether wazuh-manager.service is active or not, so that a request from a
# manager started by hand (outside the unit) is served too; the helper ignores a request when no manager
# daemon runs. Enabled at install, while wazuh-manager.service is not; that unit still wants it. After it, so
# at boot an enabled manager's ExecStartPre has removed any stale request first.
After=wazuh-manager.service
# The default Before=paths.target would close a cycle at boot (basic.target, and so wazuh-manager.service,
# come after paths.target).
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Path]
PathExists=WAZUH_HOME_TMP/var/service-control/reload
Unit=wazuh-manager-service-control@reload.service

[Install]
WantedBy=multi-user.target
