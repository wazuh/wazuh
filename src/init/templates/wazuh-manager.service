[Unit]
Description=Wazuh manager
Wants=network-online.target
# The Server API's restart and reload requests (see wazuh-manager-service-control@.service).
Wants=wazuh-manager-service-control-restart.path wazuh-manager-service-control-reload.path
After=network.target network-online.target

[Service]
Type=forking
LimitNOFILE=65536
TimeoutSec=45
# wait_for_wazuh_engine_ready (wazuh-manager-control) gives the engine ENGINE_START_BUDGET=120 s from
# its launch to the last readiness probe, and the rest of this budget covers the lock wait (up to 40 s),
# testconfig and the daemons started before analysisd; a shorter start timeout would report a systemd
# timeout instead of the script's own error. Stop keeps the 45 s above, for ExecStop and again for
# ExecStopPost.
TimeoutStartSec=180

# Sandboxing. No manager daemon chroots into the installation directory any more: the unit confines all
# of them instead. Nothing in it may gain privileges by executing a file: the Server API's restart and
# reload run wazuh-manager-service-control as root from its own unit, not setuid from here.
NoNewPrivileges=yes
ProtectSystem=full
# Writable: the installation directory and the configuration directory /etc/wazuh-manager, the only
# two places wazuh-manager-resolve-credentials --prestart writes (rbac.db and the keystore under the
# first; ca/, export/ and certs/ under the second). It reads the indexer's /etc/wazuh-indexer/export,
# which stays read-only here. '-' skips a missing path.
ReadWritePaths=WAZUH_HOME_TMP -/etc/wazuh-manager
PrivateTmp=yes
# Hides /home, /root and /run/user: an installation under /home cannot run under this unit.
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
# Every daemon drops to the wazuh-manager user and so holds no capability; the bounding set caps the
# root phase (wazuh-manager-control, the credential resolver, each daemon before its drop). Ownership and
# modes (resolver), root writes into wazuh-manager directories, the privilege drop, signals to the
# daemons on stop, and a listener port below 1024.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_KILL CAP_NET_BIND_SERVICE
SystemCallArchitectures=native
# A call outside the set fails with EPERM, so the daemon logs it instead of dying of SIGSYS.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# A request left from before this start (a reboot, a crash) must not restart or reload what it starts.
ExecStartPre=-/bin/rm -f WAZUH_HOME_TMP/var/run/service-control/restart WAZUH_HOME_TMP/var/run/service-control/reload
ExecStart=/usr/bin/env WAZUH_HOME_TMP/bin/wazuh-manager-control start
ExecStop=/usr/bin/env WAZUH_HOME_TMP/bin/wazuh-manager-control stop
# A restart that arrives during a reload makes systemd skip ExecStop and, with KillMode=process,
# signal only the reload script. This stops the daemons left behind, so the start that follows
# brings up every one of them. It is skipped when the start or stop failed on its own (exit-code):
# a refused start, or one that gave up on the lock, leaves the daemons that were already running
# alone, and a failed start has already stopped what it started. A start cut by TimeoutStartSec
# (timeout) still gets the stop. systemd before 232 leaves SERVICE_RESULT empty, so the stop always
# runs there. The agent unit has no such check: a wazuh-agentd that fails on its own is exit-code
# too, and that is one of the cases its ExecStopPost is for.
ExecStopPost=/bin/sh -c '[ "$${SERVICE_RESULT}" = exit-code ] || exec WAZUH_HOME_TMP/bin/wazuh-manager-control stop'
ExecReload=/usr/bin/env WAZUH_HOME_TMP/bin/wazuh-manager-control reload

KillMode=process
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
