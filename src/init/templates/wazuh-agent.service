[Unit]
Description=Wazuh agent
Wants=network-online.target
After=network.target network-online.target

[Service]
Type=forking
# TimeoutStartSec also bounds ExecReload, which stops and starts the daemons: a reload cut short leaves them stopped
TimeoutStartSec=180
TimeoutStopSec=45

ExecStart=/usr/bin/env WAZUH_HOME_TMP/bin/wazuh-control start
ExecStop=/usr/bin/env WAZUH_HOME_TMP/bin/wazuh-control stop
ExecReload=/usr/bin/env WAZUH_HOME_TMP/bin/wazuh-control reload

KillMode=process

[Install]
WantedBy=multi-user.target
