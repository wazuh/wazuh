# The manager's half of the credential resolution ladder. The shared half -- the credentials
# file, the locking convention, validation and generation -- is credentials-lib.sh; this file
# says only which keys the manager owns, which it consumes, and where each one is stored.
#
# The same script runs at two moments, and the difference between them is the whole design:
#
#   --install    From postinst / %post. Creates what it can, and has no opinion about
#                whether the manager can run. Never fails: a maintainer script that aborts
#                leaves the package half-configured, breaks `apt install -f` and fails image
#                builds. Exits 0 whatever it could not resolve.
#
#   --prestart   From the unit's ExecStartPre and from wazuh-manager-control start. Runs the
#                same ladder again -- not merely a check -- so a manager installed before the
#                indexer picks up what became available since and configures itself. Exits
#                non-zero naming every key it could not resolve.
#
# Validating at start rather than at install is deliberate: the answer changes between the two
# moments and only the answer at start matters. A manager installed first resolves nothing;
# by the time it is started the indexer has published its key, and it resolves. Checking at
# install would have declared a problem that no longer exists.
#
# The step never opens a network connection. It validates presence and format only -- making a
# service's start depend on reaching its peer would break boot ordering and cluster restarts.
# A credential that is present but wrong still fails as a 401 at runtime, exactly as today.

MODE="prestart"
DIR=""

while [ -n "$1" ]; do
    case "$1" in
        --install)  MODE="install" ; shift ;;
        --prestart) MODE="prestart"; shift ;;
        -H)         DIR="$2"       ; shift 2 ;;
        -h|--help)
            echo "Usage: $0 [--install|--prestart] [-H <home>]"
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 2
            ;;
    esac
done

# Derive the installation directory from our own location, so a tree installed under a
# non-default USER_DIR resolves against itself rather than against a compiled-in path.
if [ -z "${DIR}" ]; then
    _self=$(readlink -f "$0" 2>/dev/null || echo "$0")
    DIR=$(dirname "$(dirname "${_self}")")
fi

# Installed layout puts the library in lib/; the source tree has it beside this file, which is
# what lets the test suite drive the ladder without an install.
if [ -f "${DIR}/lib/credentials-lib.sh" ]; then
    . "${DIR}/lib/credentials-lib.sh"
elif [ -f "$(dirname "$0")/credentials-lib.sh" ]; then
    . "$(dirname "$0")/credentials-lib.sh"
else
    echo "resolve-credentials: cannot find credentials-lib.sh" >&2
    exit 2
fi

KEYSTORE="${DIR}/bin/wazuh-manager-keystore"
RBAC_CONTROL="${DIR}/bin/rbac_control"
RBAC_DB="${DIR}/api/configuration/security/rbac.db"
CERTS_DIR="${DIR}/etc/certs"
MINT_CERTS="${DIR}/bin/wazuh-manager-mint-certs"
[ -f "${MINT_CERTS}" ] || MINT_CERTS="$(dirname "$0")/mint-certs.sh"

# Trust material. WAZUH_CA_DIR is a path, not a credential: it moves the directory, it does not
# carry a secret. cred_get already prefers the environment over the file, so it is read the same way
# as every key.
CA_DIR=$(cred_get WAZUH_CA_DIR)
[ -n "${CA_DIR}" ] || CA_DIR="${CRED_DIR}/ca"

# Accumulated verdicts. A key is *unresolved* when nothing supplied it and we may not invent
# it; it is *invalid* when something supplied it and the value failed the policy. The two are
# reported differently because they need different fixes, but both block the start.
UNRESOLVED=""
INVALID=""

mark_unresolved() {
    UNRESOLVED="${UNRESOLVED} $1"
}

mark_invalid() {
    INVALID="${INVALID} $1"
}

# -----------------------------------------------------------------------------------------
# Step 0 tests
#
# Each is a definite marker. Inferring "already present" from a file that ships with the
# package does not work -- it would make every upgrade and every restart a coin toss.
# -----------------------------------------------------------------------------------------

rbac_is_seeded() {
    [ -s "${RBAC_DB}" ]
}

indexer_password_is_stored() {
    [ -x "${KEYSTORE}" ] || return 1
    "${KEYSTORE}" -f indexer -k password -g >/dev/null 2>&1
}

certificates_are_present() {
    [ -f "${CERTS_DIR}/remoted.pem" ] && [ -f "${CERTS_DIR}/remoted-key.pem" ] && \
    [ -f "${CERTS_DIR}/indexer-connector.pem" ] && [ -f "${CERTS_DIR}/indexer-connector-key.pem" ]
}

# -----------------------------------------------------------------------------------------
# Owned: the two Server API accounts
#
# Both live in rbac.db, hashed on seeding. They are resolved together because they are seeded
# together: rbac.db is created once, with both users, and is never reseeded afterwards.
# -----------------------------------------------------------------------------------------

API_PASSWORD=""
WUI_PASSWORD=""

resolve_api_passwords() {
    if rbac_is_seeded; then
        # Step 0 wins over both channels. Whatever the keys now say -- including a value an
        # operator edited in the file -- the database already holds a credential, and a
        # package must never reconfigure what is already configured.
        cred_log "rbac.db is already seeded; WAZUH_MANAGER_API_PASSWORD and WAZUH_MANAGER_WUI_PASSWORD are ignored"
        return 0
    fi

    for _rap_key in WAZUH_MANAGER_API_PASSWORD WAZUH_MANAGER_WUI_PASSWORD; do
        _rap_value=$(cred_get "${_rap_key}")

        if [ -n "${_rap_value}" ]; then
            # Step 1. An invalid value stops here rather than falling through to generation:
            # replacing what the operator asked for would discard their intent silently and
            # leave the deployment holding a credential nobody else has.
            if ! cred_validate_password "${_rap_key}" "${_rap_value}"; then
                mark_invalid "${_rap_key}"
                continue
            fi
            cred_log "using the supplied ${_rap_key}"
        else
            # Step 2: we own the account, so generating the value makes it true.
            _rap_value=$(cred_generate_password) || {
                mark_unresolved "${_rap_key}"
                continue
            }
            cred_log "generated ${_rap_key}"
        fi

        if [ "${_rap_key}" = "WAZUH_MANAGER_API_PASSWORD" ]; then
            API_PASSWORD="${_rap_value}"
        else
            WUI_PASSWORD="${_rap_value}"
        fi
    done

    [ -n "${INVALID}" ] && return 1
    [ -n "${API_PASSWORD}" ] && [ -n "${WUI_PASSWORD}" ] || return 1

    # A seeding failure has to be recorded, not merely returned: the caller ignores the return
    # value, so without this the run would end with nothing marked and the service would be allowed
    # to start against a database that was never created.
    if ! seed_rbac; then
        mark_unresolved "rbac.db"
        return 1
    fi

    # A component publishes every credential it owns, whether it generated the value or was
    # given one, so a sibling installed later finds it.
    cred_publish WAZUH_MANAGER_API_PASSWORD "${API_PASSWORD}"
    cred_publish WAZUH_MANAGER_WUI_PASSWORD "${WUI_PASSWORD}"

    return 0
}

# Values reach the seeding path through stdin, never argv: a secret on a command line is
# world-readable in ps for as long as the process lives.
seed_rbac() {
    if [ ! -x "${RBAC_CONTROL}" ]; then
        cred_err "cannot seed rbac.db: ${RBAC_CONTROL} is missing"
        return 1
    fi

    _sr_api=$(json_escape "${API_PASSWORD}")
    _sr_wui=$(json_escape "${WUI_PASSWORD}")

    if printf '{"wazuh": "%s", "wazuh-wui": "%s"}' "${_sr_api}" "${_sr_wui}" \
        | "${RBAC_CONTROL}" seed --passwords-file - >/dev/null 2>&1; then
        cred_log "seeded rbac.db"
        return 0
    fi

    cred_err "could not seed rbac.db"
    return 1
}

json_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# -----------------------------------------------------------------------------------------
# Consumed: the manager's account on the indexer
#
# Never generated. Inventing a password does not make the peer accept it, so this credential
# can only ever be supplied -- and when it is not, the manager is unresolved and will not
# start. That is the one case the operator is expected to meet on a fresh all-in-one host,
# and it clears itself the moment the indexer publishes its key.
# -----------------------------------------------------------------------------------------

resolve_indexer_password() {
    if indexer_password_is_stored; then
        cred_log "the indexer credential is already in the keystore"
        return 0
    fi

    _rip_value=$(cred_get WAZUH_INDEXER_MANAGER_PASSWORD)

    if [ -z "${_rip_value}" ]; then
        mark_unresolved WAZUH_INDEXER_MANAGER_PASSWORD
        return 1
    fi

    if ! cred_validate_password WAZUH_INDEXER_MANAGER_PASSWORD "${_rip_value}"; then
        mark_invalid WAZUH_INDEXER_MANAGER_PASSWORD
        return 1
    fi

    if [ ! -x "${KEYSTORE}" ]; then
        cred_err "cannot store the indexer credential: ${KEYSTORE} is missing"
        mark_unresolved WAZUH_INDEXER_MANAGER_PASSWORD
        return 1
    fi

    # Through stdin, never argv. Storing it in the manager's own keystore is what makes step 0
    # true for every later start, which is why the credentials file can be deleted once every
    # component is installed and running.
    printf '%s' "wazuh-manager" | "${KEYSTORE}" -f indexer -k username >/dev/null 2>&1
    if ! printf '%s' "${_rip_value}" | "${KEYSTORE}" -f indexer -k password >/dev/null 2>&1; then
        cred_err "could not write the indexer credential to the keystore"
        mark_unresolved WAZUH_INDEXER_MANAGER_PASSWORD
        return 1
    fi

    cred_log "stored the indexer credential in the keystore"

    # Never published: that key belongs to whoever owns the account, and two writers for one
    # name is how values get lost.
    return 0
}

# -----------------------------------------------------------------------------------------
# Owned: the manager's own certificates
# -----------------------------------------------------------------------------------------

resolve_certificates() {
    if certificates_are_present; then
        cred_log "certificates are already in place"
        return 0
    fi

    if [ ! -x "${MINT_CERTS}" ] && [ ! -f "${MINT_CERTS}" ]; then
        cred_err "cannot issue certificates: ${MINT_CERTS} is missing"
        mark_unresolved "certificates"
        return 1
    fi

    _rc_sans=$(cred_get WAZUH_MANAGER_CERT_SANS)

    if WAZUH_CA_DIR="${CA_DIR}" WAZUH_MANAGER_CERT_SANS="${_rc_sans}" \
        sh "${MINT_CERTS}" -H "${DIR}"; then
        return 0
    fi

    mark_unresolved "certificates"
    return 1
}

# -----------------------------------------------------------------------------------------
# Run
# -----------------------------------------------------------------------------------------

# A path more permissive than the rule is reported and treated as unresolved rather than
# repaired: it is either a mistake or an attack, and fixing it silently hides both.
if ! cred_check_location; then
    if [ "${MODE}" = "install" ]; then
        exit 0
    fi
    cred_err "refusing to resolve credentials from an untrusted location"
    exit 1
fi

cred_ensure_dir >/dev/null 2>&1

resolve_api_passwords
resolve_indexer_password
resolve_certificates

# The installer has no opinion about whether the component can run: no warning, no failure, no
# special state. Nothing checks credentials until something needs them.
if [ "${MODE}" = "install" ]; then
    exit 0
fi

if [ -z "${UNRESOLVED}" ] && [ -z "${INVALID}" ]; then
    exit 0
fi

# The message goes to the journal, which is where someone looks when a service will not start.
# It names every missing key and where to set it, and never prints a value.
for _key in ${INVALID}; do
    cred_err "INVALID ${_key}: the supplied value does not meet the password policy"
    cred_err "        (${CRED_PW_MIN}-${CRED_PW_MAX} characters, with an upper- and lowercase letter, a digit and a symbol)"
    cred_err "        correct it in ${CRED_FILE} and start the service again"
done

for _key in ${UNRESOLVED}; do
    case "${_key}" in
        WAZUH_INDEXER_MANAGER_PASSWORD)
            cred_err "MISSING WAZUH_INDEXER_MANAGER_PASSWORD"
            cred_err "        set it in ${CRED_FILE}, or install wazuh-indexer on this host first"
            ;;
        certificates)
            cred_err "MISSING the manager's TLS certificates in ${CERTS_DIR}"
            cred_err "        a trust anchor was found in ${CA_DIR} but no CA private key, so this host"
            cred_err "        cannot sign for itself; place an issued pair in ${CERTS_DIR}"
            ;;
        *)
            cred_err "MISSING ${_key}"
            cred_err "        set it in ${CRED_FILE}"
            ;;
    esac
done

cred_err "see https://documentation.wazuh.com/current/user-manual/manager/credentials.html"

exit 1
