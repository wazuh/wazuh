{
  "name": "mixed_fleet_windows_linux_full",
  "description": "Engine-only router queue memory test for mixed Windows/Linux simulated fleets. Each agent sends twelve 5-minute bursts with 2-minute idle gaps, alternating payload sizes and starting with Azure and ending with syslog. The final 2-minute drain leaves the monitor running with no new events so the router queue/RSS drop can be observed. Total planned runtime is about 84 minutes including the final drain.",
  "lanes": {
    "engine_router_queue_bursts": [
      {
