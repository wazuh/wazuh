<?xml version="1.0" encoding="utf-8"?>
<!--
  Installer wizard text. The WixUI strings that show [ProductName] (taken from WiX 3.11.2
  WixUI_en-us.wxl) with the product name written out, plus the CustomCheckDialog strings.
  Product/@Name stays "Wazuh Agent", so nothing that is keyed on it changes.
-->
