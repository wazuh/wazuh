<!-- ID: 85750 - 85999 -->

<!-- Same list as BAD_WORDS in 0020-syslog_rules.xml, which the generic rule 1002 uses -->
<var name="MONGODB_BAD_WORDS">core_dumped|failure|error|attack| bad |illegal |denied|refused|unauthorized|fatal|failed|Segmentation Fault|Corrupted</var>

<group name="mongodb,">

    <!--
    2017-03-27T19:32:32.916+0200 I COMMAND  [conn13388] killcursors: found 0 of 1
    -->
    <rule id="85750" level="0">
        <decoded_as>mongodb</decoded_as>
        <description>MongoDB messages</description>
    </rule>

    <!--
    2017-03-27T19:32:32.916+0200 I COMMAND  [conn13388] killcursors: found 0 of 1
    The severity is consumed by the pre-decoder and never reaches the decoders,
    so this rule groups every decoded MongoDB message regardless of severity.
    Level 0: it only groups the component rules below.
    -->
    <rule id="85755" level="0">
        <if_sid>85750</if_sid>
        <description>MongoDB: Message</description>
    </rule>

    <!--
    2017-03-27T19:32:35.916+0200 I NETWORK  [initandlisten] connection accepted from 10.10.10.10:32768 #19309 (10 connections now open)
    -->
    <rule id="85756" level="0">
        <if_sid>85755</if_sid>
        <field name="mongodb.component">NETWORK</field>
        <match>connection accepted</match>
        <description>MongoDB: Connection accepted</description>
        <group></group>
    </rule>

    <!--
    2017-03-27T19:32:33.916+0200 I NETWORK  [conn10000] end connection 10.10.10.10:33658 (15 connections now open)
    -->
    <rule id="85757" level="0">
        <if_sid>85755</if_sid>
        <field name="mongodb.component">NETWORK</field>
        <match>end connection</match>
        <description>MongoDB: End connection</description>
        <group></group>
    </rule>

    <!--
    2017-03-27T19:32:31.916+0200 I ACCESS   [conn10000] Successfully authenticated as principal snapshots on myUser
    -->
    <rule id="85758" level="3">
        <if_sid>85755</if_sid>
        <field name="mongodb.component">ACCESS</field>
        <match>Successfully authenticated</match>
        <description>MongoDB: Successfully authentication</description>
        <mitre>
            <id>T1078</id>
        </mitre>
        <group>authentication_success,pci_dss_10.2.5,gpg13_7.1,gpg13_7.2,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
    </rule>

    <!--
    2016-03-31T15:07:04.807-0500 I ACCESS [conn3] SCRAM-SHA-1 authentication failed for newdbUser on newdb from client 127.0.0.1 ; AuthenticationFailed SCRAM-SHA-1  authentication failed, storedKey mismatch
    -->
    <rule id="85759" level="4">
        <if_sid>85755</if_sid>
        <field name="mongodb.component">ACCESS</field>
        <match>authentication failed for</match>
        <description>MongoDB: Failed authentication</description>
        <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,gpg13_7.1,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
    </rule>

    <rule id="85760" level="10" frequency="8">
      <if_matched_sid>85759</if_matched_sid>
      <same_source_ip />
      <description>MongoDB: Multiple authentication failures.</description>
      <mitre>
          <id>T1110</id>
      </mitre>
      <group>authentication_failures,pci_dss_10.2.4,pci_dss_10.2.5,pci_dss_11.4,gpg13_7.1,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
    </rule>

    <!--
    2016-03-31T15:18:14.340-0500 I ACCESS   [conn7] Unauthorized not authorized on admin to execute command { createUser:  "mongoadmin2", pwd: "xxx", roles: [ { role: "userAdminAnyDatabase",  db: "admin" } ], digestPassword: false, writeConcern:   { w: "majority", wtimeout: 30000.0 } }
    -->
    <rule id="85761" level="7">
        <if_sid>85755</if_sid>
        <field name="mongodb.component">ACCESS</field>
        <regex type="pcre2">Unauthorized:? not authorized on \S+ to execute command</regex>
        <description>MongoDB: Execute commands without the necessary privileges</description>
        <group>pci_dss_10.2.5,gdpr_IV_35.7.d,gdpr_IV_32.2,</group>
    </rule>

    <!--
    Decoded MongoDB messages are not evaluated by the generic syslog rules.
    Rules 85762 and 85763 keep the alerts of rules 1007 and 1002 for the
    MongoDB messages that no specific rule above matches. They must stay
    after the specific rules.
    -->

    <!--
    2019-11-14T10:46:41.011+0000 E STORAGE  [WTCheckpointThread] WiredTiger error (28) [1573728401:11], file:WiredTiger.wt, WT_SESSION.checkpoint: No space left on device
    -->
    <rule id="85762" level="7">
        <if_sid>85755</if_sid>
        <match>file system full|No space left on device</match>
        <description>MongoDB: File system full</description>
        <group>low_diskspace,pci_dss_10.6.1,gpg13_4.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,tsc_CC7.2,tsc_CC7.3,</group>
    </rule>

    <!--
    2019-11-14T10:46:41.013+0000 E QUERY    [conn5] Plan executor error during find command: FAILURE, stats: {}
    2019-11-14T10:46:41.012+0000 F -        [WTCheckpointThread] Fatal Assertion 28559 at src/mongo/db/storage/wiredtiger/wiredtiger_util.cpp 64
    -->
    <rule id="85763" level="2">
        <if_sid>85755</if_sid>
        <match>$MONGODB_BAD_WORDS</match>
        <description>MongoDB: Error message</description>
        <group>gpg13_4.3,</group>
    </rule>

</group>
