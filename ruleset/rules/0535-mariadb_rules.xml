<group name="mariadb,">
  <rule id="88100" level="0">
    <decoded_as>mariadb-syslog</decoded_as>
    <description>MariaDB group messages.</description>
  </rule>

  <rule id="88101" level="5">
    <if_sid>88100</if_sid>
    <field name="mariadb.type">[ERROR]</field>
    <description>MariaDB error message</description>
    <group>gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="88102" level="3">
    <if_sid>88100</if_sid>
    <field name="mariadb.type">[Warning]</field>
    <description>MariaDB warning message</description>
  </rule>

  <rule id="88103" level="0">
    <if_sid>88100</if_sid>
    <field name="mariadb.type">[NOTE]</field>
    <description>MariaDB log message</description>
  </rule>

  <rule id="88104" level="9">
    <if_sid>88100</if_sid>
    <match>Access denied for user</match>
    <description>MariaDB: authentication failure.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,pci_dss_8.7,gpg13_7.1,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,hipaa_164.312.d,hipaa_164.312.e.1,hipaa_164.312.e.2.I,hipaa_164.312.e.2.II,nist_800_53_AU.14,nist_800_53_AC.7,nist_800_53_SC.2,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,tsc_PI1.4,tsc_PI1.5,</group>
  </rule>
</group>
